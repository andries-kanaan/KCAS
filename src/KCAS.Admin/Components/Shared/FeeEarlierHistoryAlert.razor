@using KCAS.Admin.Data
@if (Notices.Count > 0)
{
    <section class="alert alert-warning mb-4" role="alert" aria-label="Earlier AIMS / Glacier statement required">
        <h2 class="h5"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Earlier AIMS / Glacier statement required</h2>
        <p>The supplied statements start with existing investment balances for the accounts below. Upload earlier AIMS / Glacier statements from the first investment at that administrator through the date shown. No history from a previous administrator is required.</p>
        <div class="table-responsive"><table class="table table-sm mb-2">
            <thead><tr><th>Account</th><th>Supplied history starts</th><th class="text-end">Existing opening balance (R)</th><th>Earlier history needed through</th></tr></thead>
            <tbody>@foreach (var notice in Notices)
            {
                <tr><td>@notice.Account</td><td class="text-nowrap">@notice.StatementFrom.ToString("yyyy-MM-dd")</td><td class="text-end">@notice.OpeningValue.ToString("N2")</td><td class="text-nowrap">@notice.RequiredThrough.ToString("yyyy-MM-dd")</td></tr>
            }</tbody>
        </table></div>
        <p class="mb-2">Accounts receiving transfers from these investments may also need this history to carry their benchmark and high-water-mark protection. Moving the money does not establish a new fee starting point.</p>
        @if (!string.IsNullOrEmpty(UploadTarget))
        { <a class="btn btn-outline-dark btn-sm" href="@UploadTarget"><i class="bi bi-upload me-1" aria-hidden="true"></i>Upload earlier statements</a> }
    </section>
}
@code {
    [Parameter, EditorRequired] public IReadOnlyList<FeeEarlierHistoryNotice> Notices { get; set; } = [];
    [Parameter] public string? UploadTarget { get; set; }
}
