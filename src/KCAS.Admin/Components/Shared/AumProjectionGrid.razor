@using KCAS.Admin.Data

@if (Table.Rows.Count > 0)
{
    <section class="aum-grid mb-4">
        @if (!string.IsNullOrEmpty(Table.Title))
        {
            <h2 class="h6 mb-2">@Table.Title</h2>
        }
        <div class="table-responsive" tabindex="0" aria-label="@(string.IsNullOrEmpty(Table.Title) ? Table.Headings[0] : Table.Title)">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead class="table-light"><tr>
                    @foreach (var heading in Table.Headings)
                    {
                        <th scope="col">@heading</th>
                    }
                </tr></thead>
                <tbody>
                    @foreach (var row in Table.Rows)
                    {
                        <tr class="@(row[0] is "Closing AUM" or "Result after support" or "Operating profit / (loss)" or "Result after support per month" ? "table-active fw-semibold" : null)">
                            <th scope="row" class="aum-row-label">@AumProjectionTables.Display(row[0])</th>
                            @foreach (var value in row.Skip(1))
                            {
                                <td class="@(value is double or AumPercent or AumDecimal or DateOnly ? "text-end text-nowrap" : null)">
                                    @if (value is "Stopped" or "Continues")
                                    {
                                        <span class="badge @(value is "Stopped" ? "text-bg-success" : "text-bg-warning")">@value</span>
                                    }
                                    else
                                    {
                                        @AumProjectionTables.Display(value)
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public AumReportTable Table { get; set; } = null!;
}
