@page "/clients/{ClientId:int}/ownership"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@inject ClientEntityOwnershipService OwnershipService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Ownership and related parties</PageTitle>

@if (model is null)
{
    <p>Loading ownership register...</p>
}
else
{
    <div class="page-header">
        <div>
            <p class="eyebrow">Ownership and related parties</p>
            <h1>@model.DisplayName</h1>
            <p class="text-muted mb-0">@DisplayCategory(model.ClientCategory) | Review: @model.Profile.OwnershipReviewStatus</p>
        </div>
        <div class="header-actions">
            <a class="btn btn-outline-secondary" href="@($"/clients/{ClientId}/evidence")">Evidence readiness</a>
            <a class="btn btn-outline-secondary" href="@($"/clients/{ClientId}")">Client detail</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info">@statusMessage</div>
    }

    @if (model.Blockers.Count > 0)
    {
        <section class="work-area">
            <h2>Outstanding ownership requirements</h2>
            <ul class="mb-0">
                @foreach (var blocker in model.Blockers)
                {
                    <li>@blocker</li>
                }
            </ul>
        </section>
    }

    <section class="work-area">
        <h2>Action reason</h2>
        <input class="form-control" @bind="reason" placeholder="Required reason for every ownership change" disabled="@(!canManage)" />
    </section>

    <section class="work-area">
        <h2>Entity profile</h2>
        <EditForm Model="model.Profile" OnValidSubmit="SaveProfileAsync" FormName="entity-profile">
            <div class="detail-grid">
                <label>
                    Legal form
                    <select class="form-select" @bind="model.Profile.LegalForm" disabled="@(!canManage)">
                        <option value="">Select legal form</option>
                        @foreach (var legalForm in LegalForms(model.ClientCategory))
                        {
                            <option value="@legalForm">@legalForm</option>
                        }
                    </select>
                </label>
                <label>Registration or trust number <InputText class="form-control" @bind-Value="model.Profile.RegistrationNumber" disabled="@(!canManage)" /></label>
                <label>Registration country <InputText class="form-control" @bind-Value="model.Profile.RegistrationCountry" disabled="@(!canManage)" /></label>
                <label>Establishment date <InputDate class="form-control" @bind-Value="model.Profile.EstablishmentDate" disabled="@(!canManage)" /></label>
            </div>
            <label class="mt-3">
                Nature of business or trust purpose
                <InputTextArea class="form-control" rows="3" @bind-Value="model.Profile.NatureOfBusinessOrPurpose" disabled="@(!canManage)" />
            </label>
            @if (canManage)
            {
                <button type="submit" class="btn btn-primary mt-3">Save entity profile</button>
            }
        </EditForm>
    </section>

    <section class="work-area">
        <div class="section-heading-row">
            <div>
                <h2>Related parties</h2>
                <p class="section-subtitle">Record each relevant natural person, legal entity, or beneficiary class once and select all applicable roles.</p>
            </div>
            @if (canManage)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="NewParty">Add related party</button>
            }
        </div>

        @if (editingParty is not null)
        {
            <EditForm Model="editingParty" OnValidSubmit="SavePartyAsync" FormName="related-party">
                <div class="detail-grid">
                    <label>
                        Party type
                        <InputSelect class="form-select" @bind-Value="editingParty.PartyType">
                            @foreach (var partyType in ClientRelatedPartyTypes.All)
                            {
                                <option value="@partyType">@DisplayCategory(partyType)</option>
                            }
                        </InputSelect>
                    </label>
                    <label>Name or description <InputText class="form-control" @bind-Value="editingParty.DisplayName" /></label>
                    <label>South African ID <InputText class="form-control" @bind-Value="editingParty.SouthAfricanIdNumber" /></label>
                    <label>Passport number <InputText class="form-control" @bind-Value="editingParty.PassportNumber" /></label>
                    <label>Passport country <InputText class="form-control" @bind-Value="editingParty.PassportCountry" /></label>
                    <label>Entity registration number <InputText class="form-control" @bind-Value="editingParty.RegistrationNumber" /></label>
                    <label>Birth date <InputDate class="form-control" @bind-Value="editingParty.BirthDate" /></label>
                    <label>Nationality <InputText class="form-control" @bind-Value="editingParty.Nationality" /></label>
                    <label>Country of residence <InputText class="form-control" @bind-Value="editingParty.CountryOfResidence" /></label>
                    <label>Ownership percentage <InputNumber class="form-control" @bind-Value="editingParty.OwnershipPercent" /></label>
                    <label>Effective from <InputDate class="form-control" @bind-Value="editingParty.EffectiveFrom" /></label>
                    <label>Effective to <InputDate class="form-control" @bind-Value="editingParty.EffectiveTo" /></label>
                </div>
                <fieldset class="mt-3">
                    <legend class="h6">Roles</legend>
                    <div class="row-actions">
                        @foreach (var role in ClientRelatedPartyRoles.All)
                        {
                            <label class="check-row">
                                <input type="checkbox" checked="@editingParty.Roles.Contains(role)" @onchange="args => ToggleRole(role, args)" />
                                @DisplayRole(role)
                            </label>
                        }
                    </div>
                </fieldset>
                <label class="mt-3">Control basis <InputTextArea class="form-control" rows="2" @bind-Value="editingParty.ControlBasis" /></label>
                <label class="mt-3">Authority basis <InputTextArea class="form-control" rows="2" @bind-Value="editingParty.AuthorityBasis" /></label>
                <label class="mt-3">Notes <InputTextArea class="form-control" rows="2" @bind-Value="editingParty.Notes" /></label>
                <div class="row-actions mt-3">
                    <button type="submit" class="btn btn-primary">Save related party</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelPartyEdit">Cancel</button>
                </div>
            </EditForm>
        }

        @foreach (var party in model.Parties)
        {
            <article class="detail-panel mt-3">
                <div class="section-heading-row">
                    <div>
                        <h3>@party.DisplayName</h3>
                        <p class="section-subtitle">@DisplayCategory(party.PartyType) | @(party.IsActive ? "Active" : "Inactive")</p>
                    </div>
                    @if (canManage && party.IsActive)
                    {
                        <div class="row-actions">
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => EditParty(party)">Edit</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => DeactivatePartyAsync(party.Id!.Value)">Deactivate</button>
                        </div>
                    }
                </div>
                <dl>
                    <dt>Roles</dt><dd>@string.Join(", ", party.Roles.Select(DisplayRole))</dd>
                    <dt>Ownership</dt><dd>@(party.OwnershipPercent is null ? "-" : $"{party.OwnershipPercent:0.##}%")</dd>
                    <dt>Control basis</dt><dd>@Display(party.ControlBasis)</dd>
                    <dt>Authority basis</dt><dd>@Display(party.AuthorityBasis)</dd>
                    <dt>Identity</dt><dd>@Display(party.SouthAfricanIdNumber ?? party.PassportNumber ?? party.RegistrationNumber)</dd>
                </dl>

                <h4 class="h6">Linked evidence</h4>
                @if (party.EvidenceLinks.Count == 0)
                {
                    <p class="text-muted">No party-specific evidence linked.</p>
                }
                else
                {
                    <ul>
                        @foreach (var link in party.EvidenceLinks)
                        {
                            <li>
                                @link.Purpose: @link.EvidenceTitle (@(link.VerifiedDate is null ? "unverified" : $"verified {link.VerifiedDate:yyyy-MM-dd}"))
                                @if (canManage)
                                {
                                    <button type="button" class="btn btn-link btn-sm" @onclick="() => UnlinkEvidenceAsync(link.Id)">Unlink</button>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (canManage && party.IsActive)
                {
                    <div class="workspace-grid">
                        <select class="form-select" value="@SelectedEvidence(party.Id!.Value)" @onchange="args => SetSelectedEvidence(party.Id.Value, args)">
                            <option value="">Select client evidence</option>
                            @foreach (var evidence in model.EvidenceChoices)
                            {
                                <option value="@evidence.Id">@evidence.Title (@evidence.EvidenceType; @(evidence.VerifiedDate is null ? "unverified" : "verified"))</option>
                            }
                        </select>
                        <select class="form-select" value="@SelectedPurpose(party.Id.Value)" @onchange="args => SetSelectedPurpose(party.Id.Value, args)">
                            @foreach (var purpose in ClientRelatedPartyEvidencePurposes.All)
                            {
                                <option value="@purpose">@purpose</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-primary" @onclick="() => LinkEvidenceAsync(party.Id.Value)">Link evidence</button>
                    </div>
                }
            </article>
        }
    </section>

    <section class="work-area">
        <h2>Ownership/control conclusion</h2>
        <dl>
            <dt>Status</dt><dd>@model.Profile.OwnershipReviewStatus</dd>
            <dt>Conclusion</dt><dd>@Display(model.Profile.ControlConclusion)</dd>
            <dt>Reason</dt><dd>@Display(model.Profile.ControlConclusionReason)</dd>
            <dt>Reviewed by</dt><dd>@Display(model.Profile.OwnershipReviewedBy)</dd>
            <dt>Next review</dt><dd>@(model.Profile.NextOwnershipReviewDate?.ToString("yyyy-MM-dd") ?? "-")</dd>
        </dl>
        @if (canManage)
        {
            <div class="detail-grid">
                <label>
                    Conclusion
                    <select class="form-select" @bind="reviewConclusion">
                        @foreach (var conclusion in ClientControlConclusions.All)
                        {
                            <option value="@conclusion">@DisplayCategory(conclusion)</option>
                        }
                    </select>
                </label>
                <label>Next review date <InputDate class="form-control" @bind-Value="nextReviewDate" /></label>
            </div>
            <label class="mt-3">Conclusion reason <InputTextArea class="form-control" rows="3" @bind-Value="reviewConclusionReason" /></label>
            <button type="button" class="btn btn-primary mt-3" @onclick="CompleteReviewAsync">Complete ownership review</button>
        }
    </section>
}

@code {
    [Parameter] public int ClientId { get; set; }

    private ClientEntityOwnershipModel? model;
    private ClientRelatedPartyEditModel? editingParty;
    private bool canManage;
    private string? currentUser;
    private string? reason;
    private string? statusMessage;
    private string reviewConclusion = ClientControlConclusions.NaturalPersonsIdentified;
    private string? reviewConclusionReason;
    private DateOnly? nextReviewDate = DateOnly.FromDateTime(DateTime.Today.AddYears(1));
    private readonly Dictionary<int, int?> evidenceSelections = [];
    private readonly Dictionary<int, string> purposeSelections = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User.Identity?.Name;
        canManage = authState.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceManage);
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentUser is not null) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            model = await OwnershipService.LoadAsync(ClientId);
            reviewConclusion = model.Profile.ControlConclusion ?? ClientControlConclusions.NaturalPersonsIdentified;
            reviewConclusionReason = model.Profile.ControlConclusionReason;
            nextReviewDate = model.Profile.NextOwnershipReviewDate ?? DateOnly.FromDateTime(DateTime.Today.AddYears(1));
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task SaveProfileAsync() =>
        await ExecuteAsync(() => OwnershipService.SaveProfileAsync(ClientId, model!.Profile, currentUser, reason ?? ""));

    private void NewParty() => editingParty = new ClientRelatedPartyEditModel { EffectiveFrom = DateOnly.FromDateTime(DateTime.Today) };

    private void EditParty(ClientRelatedPartyModel party) => editingParty = new ClientRelatedPartyEditModel
    {
        Id = party.Id,
        PartyType = party.PartyType,
        DisplayName = party.DisplayName,
        SouthAfricanIdNumber = party.SouthAfricanIdNumber,
        PassportNumber = party.PassportNumber,
        PassportCountry = party.PassportCountry,
        RegistrationNumber = party.RegistrationNumber,
        BirthDate = party.BirthDate,
        Nationality = party.Nationality,
        CountryOfResidence = party.CountryOfResidence,
        OwnershipPercent = party.OwnershipPercent,
        ControlBasis = party.ControlBasis,
        AuthorityBasis = party.AuthorityBasis,
        EffectiveFrom = party.EffectiveFrom,
        EffectiveTo = party.EffectiveTo,
        Notes = party.Notes,
        Roles = [.. party.Roles]
    };

    private void CancelPartyEdit() => editingParty = null;

    private void ToggleRole(string role, ChangeEventArgs args)
    {
        if (editingParty is null) return;
        if (args.Value is bool selected && selected)
        {
            if (!editingParty.Roles.Contains(role)) editingParty.Roles.Add(role);
        }
        else
        {
            editingParty.Roles.Remove(role);
        }
    }

    private async Task SavePartyAsync()
    {
        if (editingParty is null) return;
        await ExecuteAsync(async () =>
        {
            await OwnershipService.SavePartyAsync(ClientId, editingParty, currentUser, reason ?? "");
            editingParty = null;
        });
    }

    private async Task DeactivatePartyAsync(int partyId) =>
        await ExecuteAsync(() => OwnershipService.DeactivatePartyAsync(ClientId, partyId, currentUser, reason ?? ""));

    private async Task LinkEvidenceAsync(int partyId)
    {
        if (!evidenceSelections.TryGetValue(partyId, out var evidenceId) || evidenceId is null)
        {
            statusMessage = "Select evidence to link.";
            return;
        }
        await ExecuteAsync(() => OwnershipService.LinkEvidenceAsync(ClientId, partyId, evidenceId.Value, SelectedPurpose(partyId), currentUser, reason ?? ""));
    }

    private async Task UnlinkEvidenceAsync(int linkId) =>
        await ExecuteAsync(() => OwnershipService.UnlinkEvidenceAsync(ClientId, linkId, currentUser, reason ?? ""));

    private async Task CompleteReviewAsync()
    {
        if (nextReviewDate is null)
        {
            statusMessage = "Next review date is required.";
            return;
        }
        await ExecuteAsync(() => OwnershipService.CompleteOwnershipReviewAsync(
            ClientId, reviewConclusion, reviewConclusionReason ?? "", nextReviewDate.Value, currentUser, reason ?? ""));
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        try
        {
            await action();
            statusMessage = "Ownership register updated.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private string SelectedEvidence(int partyId) => evidenceSelections.TryGetValue(partyId, out var value) ? value?.ToString() ?? "" : "";
    private string SelectedPurpose(int partyId) => purposeSelections.TryGetValue(partyId, out var value) ? value : ClientRelatedPartyEvidencePurposes.Identity;
    private void SetSelectedEvidence(int partyId, ChangeEventArgs args) =>
        evidenceSelections[partyId] = int.TryParse(args.Value?.ToString(), out var value) ? value : null;
    private void SetSelectedPurpose(int partyId, ChangeEventArgs args) =>
        purposeSelections[partyId] = args.Value?.ToString() ?? ClientRelatedPartyEvidencePurposes.Other;

    private static IEnumerable<string> LegalForms(string category) => category == ClientCategories.Trust
        ? ["Trust", "ForeignTrust", "OtherArrangement"]
        : ["Company", "CloseCorporation", "Partnership", "ForeignLegalPerson", "OtherLegalPerson"];
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DisplayCategory(string? value) => value switch
    {
        ClientCategories.LegalPerson => "Legal person",
        ClientCategories.NaturalPerson => "Natural person",
        ClientRelatedPartyTypes.LegalEntity => "Legal entity",
        ClientRelatedPartyTypes.BeneficiaryClass => "Beneficiary class",
        ClientControlConclusions.NaturalPersonsIdentified => "Natural persons identified",
        ClientControlConclusions.SeniorManagingOfficialFallback => "Senior managing official fallback",
        _ => value ?? "-"
    };
    private static string DisplayRole(string role) => role switch
    {
        ClientRelatedPartyRoles.MemberShareholder => "Member / shareholder",
        ClientRelatedPartyRoles.BeneficialOwner => "Beneficial owner",
        ClientRelatedPartyRoles.AuthorisedPerson => "Authorised person",
        ClientRelatedPartyRoles.SeniorManagingOfficial => "Senior managing official",
        _ => role
    };
}
