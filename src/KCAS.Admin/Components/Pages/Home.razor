@page "/"
@using Microsoft.EntityFrameworkCore
@using KCAS.Admin.Data
@using KCAS.Admin.Security
@inject ApplicationDbContext Db
@inject ComplianceWorkService WorkService
@inject EmployeeComplianceService Employees
@inject ClientOnboardingService Onboarding
@inject ClientAdvicePreparationService AdvicePreparation
@inject ClientSanctionsCoverageService Sanctions
@inject SanctionsAutomationService SanctionsAutomation
@inject ComplaintRegisterService Complaints
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Home - KCAS</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Kanaan Asset Managers</p>
        <h1>Home</h1>
        <p class="text-muted mb-0">Reviews, requests and follow-up.</p>
    </div>
    <div class="header-actions">
        <AuthorizeView Policy="@KcasPermissions.ClientsView"><Authorized><a class="btn btn-primary" href="/clients">Clients</a></Authorized></AuthorizeView>
        <AuthorizeView Policy="@KcasPermissions.AdviceView"><Authorized><a class="btn btn-outline-primary" href="/advice">Advice register</a></Authorized></AuthorizeView>
        <AuthorizeView Policy="@KcasPermissions.ComplianceView"><Authorized><a class="btn btn-outline-secondary" href="/compliance/work-register">Compliance worklist</a></Authorized></AuthorizeView>
        <AuthorizeView><NotAuthorized><a class="btn btn-primary" href="/Account/Login">Sign in</a></NotAuthorized></AuthorizeView>
    </div>
</div>

@if (canViewClients)
{
<section class="metric-grid">
    <div class="metric-card">
        <span class="metric-label">Clients</span>
        <strong>@clientCount</strong>
    </div>
    <div class="metric-card">
        <span class="metric-label">Current clients</span>
        <strong>@currentClientCount</strong>
    </div>
</section>
}

@if (annualNotificationsCreated > 0)
{
    <div class="alert alert-success">
        @annualNotificationsCreated annual compliance-review notification(s) sent to users with ComplianceAdministrator or ComplianceApprover rights.
    </div>
}

@if (codexNotifications.Count > 0)
{
    <section class="work-area"><h2>Awaiting Codex review</h2><div class="list-group">
        @foreach (var item in codexNotifications)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <strong>@item.ClientName</strong><a class="btn btn-sm btn-primary" href="@($"/clients/{item.ClientId}/onboarding")">Open Codex task</a>
            </div>
        }
    </div></section>
}
@if (adviceNotifications.Count > 0)
{
    <section class="work-area"><h2>Awaiting Codex advice preparation</h2><div class="list-group">
        @foreach (var item in adviceNotifications)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-break" style="min-width: 0; max-width: 100%"><strong>@item.ClientName</strong><div class="small">Case @item.CaseId - requested by @item.RequestedBy - @item.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div></div>
                <a class="btn btn-sm btn-primary" href="@($"/clients/{item.ClientId}/advice/{item.CaseId}/preparation")">Open advice handoff</a>
            </div>
        }
    </div></section>
}
@if (controlReminders.Count > 0)
{
    <section class="work-area compliance-control-follow-up"><h2>Compliance follow-up</h2><div class="list-group">
        @foreach (var item in controlReminders)
        {
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span><strong>@item.Title</strong> · Outstanding: @item.Outstanding</span>
                <a class="btn btn-sm btn-outline-primary" href="@item.Url">Review</a>
            </div>
        }
    </div></section>
}
@if (controlReminderError is not null) { <div class="alert alert-warning">Compliance follow-up could not be loaded. @controlReminderError</div> }
@if (employeeNotifications.Count > 0)
{
    <section class="work-area">
        <h2>Employee compliance reviews</h2>
        @if (employeeNotificationsCreated > 0) { <p class="text-success">@employeeNotificationsCreated due-review in-app task(s) created; no email sent.</p> }
        <div class="list-group">
            @foreach (var item in employeeNotifications.Take(10))
            {
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div><strong>@item.EmployeeName</strong><div class="small">@item.Task.Kind · @item.Task.Status · Due: @(item.Task.DueDate?.ToString("yyyy-MM-dd") ?? "On creation")</div></div>
                    <a class="btn btn-sm btn-outline-primary" href="@($"/compliance/employees/{item.Task.EmployeeProfileId}")">Review employee</a>
                </div>
            }
        </div>
        <a class="btn btn-outline-secondary mt-3" href="/compliance/employees/tasks">All employee review tasks (@employeeNotifications.Count)</a>
    </section>
}
@if (employeeNotificationError is not null) { <div class="alert alert-warning">Employee review notifications could not be loaded. @employeeNotificationError</div> }

@if (reviewNotifications.Count > 0)
{
    <section class="work-area">
        <h2>Client compliance reviews due</h2>
        <p class="text-muted">These reminders are shared with Compliance Administrators and Compliance Approvers.</p>
        <div class="list-group">
            @foreach (var item in reviewNotifications.Take(10))
            {
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>@item.Title</strong>
                        <div class="text-muted small">Due: @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    </div>
                    @if (item.ClientId.HasValue)
                    {
                        <a class="btn btn-sm btn-primary" href="@($"/clients/{item.ClientId}/evidence")">Review client</a>
                    }
                </div>
            }
        </div>
        <a class="btn btn-outline-secondary mt-3" href="/compliance/work-register">All client review tasks (@reviewNotifications.Count)</a>
    </section>
}

@if (isSignedIn && codexNotifications.Count + adviceNotifications.Count + controlReminders.Count + employeeNotifications.Count + reviewNotifications.Count == 0 && controlReminderError is null && employeeNotificationError is null)
{
    <section class="work-area"><h2>Review notifications</h2><p class="text-muted mb-0">No outstanding review notifications for your account.</p></section>
}

@code {
    private int clientCount;
    private int currentClientCount;
    private bool canViewClients;
    private bool isSignedIn;
    private IReadOnlyList<ComplianceWorkListItem> reviewNotifications = [];
    private IReadOnlyList<ClientCodexNotification> codexNotifications = [];
    private IReadOnlyList<AdvicePreparationNotification> adviceNotifications = [];
    private int annualNotificationsCreated;
    private IReadOnlyList<EmployeeTaskRow> employeeNotifications = [];
    private int employeeNotificationsCreated;
    private string? employeeNotificationError;
    private List<ComplianceControlReminder> controlReminders = [];
    private string? controlReminderError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isSignedIn = state.User.Identity?.IsAuthenticated == true;
        canViewClients = (await Authorization.AuthorizeAsync(state.User, null, KcasPermissions.ClientsView)).Succeeded;
        var isAdministrator = state.User.IsInRole(KcasRoles.Administrator);
        if (canViewClients)
        {
            var clients = Db.Clients.Where(client => isAdministrator || !client.ExcludeFromComplianceLists);
            clientCount = await clients.CountAsync();
            currentClientCount = await clients.CountAsync(client => client.LifecycleStatus == ClientLifecycleStatuses.Current);
        }
        if ((await Authorization.AuthorizeAsync(state.User, null, KcasPermissions.EmployeesView)).Succeeded)
        {
            try
            {
                employeeNotificationsCreated = await Employees.RefreshDueTasksAsync(state.User);
                employeeNotifications = await Employees.TasksAsync(state.User);
            }
            catch (Exception ex) { employeeNotificationError = ex.Message; }
        }
        var userName = state.User.Identity?.Name;
        var canReceiveComplianceReviews = state.User.IsInRole(KcasRoles.ComplianceAdministrator) ||
                                          state.User.IsInRole(KcasRoles.ComplianceApprover);
        if (canReceiveComplianceReviews && !string.IsNullOrWhiteSpace(userName))
        {
            try
            {
                if (await Sanctions.ReminderAsync(state.User) is { } sanctions) controlReminders.Add(sanctions);
                if (await SanctionsAutomation.ReminderAsync(state.User) is { } source) controlReminders.Add(source);
                if (await Complaints.ReminderAsync(state.User) is { } complaints) controlReminders.Add(complaints);
            }
            catch (Exception ex) { controlReminderError = ex.Message; }
            codexNotifications = await Onboarding.NotificationsAsync(state.User);
            adviceNotifications = await AdvicePreparation.NotificationsAsync(state.User);
            annualNotificationsCreated = await WorkService.EnsureAnnualClientReviewTasksAsync(DateOnly.FromDateTime(DateTime.Today), userName);
            reviewNotifications = await WorkService.LoadDueReviewNotificationsAsync(
                state.User.IsInRole(KcasRoles.Administrator));
        }
    }
}
