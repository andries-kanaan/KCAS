@page "/"
@using Microsoft.EntityFrameworkCore
@using KCAS.Admin.Data
@using KCAS.Admin.Security
@inject ApplicationDbContext Db
@inject ComplianceWorkService WorkService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>KCAS Admin</PageTitle>

<section class="landing-hero">
    <div>
        <p class="eyebrow">Kanaan Client Administration System</p>
        <h2>Kanaan Client Administration System</h2>
        <p>Use this workspace as the new KCAS foundation while client records, identity, and compliance workflows move across from the legacy system.</p>
        <div class="hero-actions">
            <a class="button-primary" href="clients">Open clients</a>
            <AuthorizeView>
                <Authorized>
                    <a class="button-secondary" href="Account/Manage">Account</a>
                </Authorized>
                <NotAuthorized>
                    <a class="button-secondary" href="Account/Login">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</section>

<div class="page-header">
    <div>
        <p class="eyebrow">Workspace status</p>
        <h1>Today at a glance</h1>
        <p class="lede">Core services are connected to the MySQL-backed KCAS schema and ready for the next workflow screens.</p>
    </div>
</div>

<section class="metric-grid">
    <div class="metric-card">
        <span class="metric-label">Clients</span>
        <strong>@clientCount</strong>
    </div>
    <div class="metric-card">
        <span class="metric-label">Current clients</span>
        <strong>@currentClientCount</strong>
    </div>
    <div class="metric-card">
        <span class="metric-label">Database</span>
        <strong>@databaseStatus</strong>
    </div>
</section>

@if (annualNotificationsCreated > 0)
{
    <div class="alert alert-success">
        @annualNotificationsCreated annual compliance-review notification(s) sent to users with ComplianceAdministrator or ComplianceApprover rights.
    </div>
}

@if (reviewNotifications.Count > 0)
{
    <section class="work-area">
        <h2>Client compliance reviews due</h2>
        <p class="text-muted">These reminders are shared with Compliance Administrators and Compliance Approvers.</p>
        <div class="list-group">
            @foreach (var item in reviewNotifications)
            {
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>@item.Title</strong>
                        <div class="text-muted small">Due: @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    </div>
                    @if (item.ClientId.HasValue)
                    {
                        <a class="btn btn-sm btn-primary" href="@($"/clients/{item.ClientId}/evidence")">Review client</a>
                    }
                </div>
            }
        </div>
        <a class="btn btn-outline-secondary mt-3" href="/compliance/work-register">Open compliance worklist</a>
    </section>
}

<section class="work-area">
    <h2>Foundation areas</h2>
    <div class="workspace-grid">
        <div>
            <h3>Client records</h3>
            <p>Start from a clean Blazor and MySQL-backed client register before importing and redesigning the Yii1 functionality.</p>
        </div>
        <div>
            <h3>Identity</h3>
            <p>ASP.NET Core Identity is enabled for user registration, login, account management, and future role-based access control.</p>
        </div>
        <div>
            <h3>Compliance foundation</h3>
            <p>The first schema keeps personal information explicit so POPIA, FICA, and audit requirements can be added deliberately.</p>
        </div>
    </div>
</section>

@code {
    private int clientCount;
    private int currentClientCount;
    private string databaseStatus = "Pending";
    private IReadOnlyList<ComplianceWorkListItem> reviewNotifications = [];
    private int annualNotificationsCreated;

    protected override async Task OnInitializedAsync()
    {
        clientCount = await Db.Clients.CountAsync();
        currentClientCount = await Db.Clients.CountAsync(
            client => client.LifecycleStatus == ClientLifecycleStatuses.Current);
        databaseStatus = "Online";
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userName = state.User.Identity?.Name;
        var canReceiveComplianceReviews = state.User.IsInRole(KcasRoles.ComplianceAdministrator) ||
                                          state.User.IsInRole(KcasRoles.ComplianceApprover);
        if (canReceiveComplianceReviews && !string.IsNullOrWhiteSpace(userName))
        {
            annualNotificationsCreated = await WorkService.EnsureAnnualClientReviewTasksAsync(DateOnly.FromDateTime(DateTime.Today), userName);
            reviewNotifications = await WorkService.LoadDueReviewNotificationsAsync();
        }
    }
}
