@page "/compliance/programme-transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPolicies.AdministratorOnly)]
@using System.ComponentModel.DataAnnotations
@using KCAS.Admin.Data
@inject ComplianceProgrammeTransferService TransferService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Programme transfers</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Controlled programme transfer</p>
        <h1>RMCP and BRA transfer</h1>
        <p class="lede">Move the current signed-final RMCP, BRA, supporting documents, and evidence records from laptop KCAS to live.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/compliance/programme">Compliance programme</a>
</div>

<div class="alert alert-info">
    Packages are AES-256 encrypted. Document files are not embedded; file locations are remapped from
    <code>@TransferService.LocalSignedFinalRoot</code> to <code>@TransferService.LiveSignedFinalRoot</code>.
    Current package storage: <code>@TransferService.StorageRoot</code>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
}

<section class="detail-grid">
    <article class="detail-panel form-panel">
        <h2>1. Export current programme bundle</h2>
        <p class="text-muted">Exports the active BRA, the active linked RMCP, and signed-final document/evidence records under the approved local folder.</p>
        <label>Export reason <textarea class="form-control" @bind="exportReason"></textarea></label>
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphrase" />
        </label>
        <label>
            Confirm passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphraseConfirm" />
        </label>
        <button class="btn btn-primary" type="button" @onclick="ExportAsync" disabled="@isBusy">
            Create encrypted package
        </button>

        @if (exportResult is not null)
        {
            <div class="alert alert-success mt-3">
                <strong>@exportResult.FileName</strong>
                <div>@exportResult.BusinessRiskAssessmentName</div>
                <div>@exportResult.RmcpTitle</div>
                <div>@exportResult.ControlledDocumentCount document(s); @exportResult.EvidenceCount evidence record(s)</div>
                <div>@FormatBytes(exportResult.SizeBytes)</div>
                <div class="small text-muted">@exportResult.StoragePath</div>
                <a class="btn btn-outline-primary btn-sm mt-2"
                   href="@($"/compliance/programme-transfers/{exportResult.PackageId}/download")">
                    Download package
                </a>
            </div>
        }
    </article>

    <article class="detail-panel form-panel">
        <h2>2. Preview and apply on live</h2>
        <p class="text-muted">Preview never changes data. Applying updates the matching BRA/RMCP records and stores the live folder paths.</p>
        <label>
            Encrypted package
            <InputFile class="form-control" OnChange="SelectImportFileAsync" accept=".kcas-programme" />
        </label>
        @if (!string.IsNullOrWhiteSpace(importFileName))
        {
            <div class="text-muted small">Selected: @importFileName</div>
        }
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="current-password" @bind="importPassphrase" />
        </label>
        <button class="btn btn-outline-primary" type="button" @onclick="PreviewAsync"
                disabled="@(isBusy || importBytes is null)">
            Preview package
        </button>

        @if (preview is not null)
        {
            <div class="mt-3">
                <h3>Preview</h3>
                <dl class="detail-list">
                    <dt>BRA</dt><dd>@preview.Package.BusinessRiskAssessment.Name (@preview.Package.BusinessRiskAssessment.AssessmentYear)</dd>
                    <dt>RMCP</dt><dd>@preview.Package.RmcpVersion.Title (@preview.Package.RmcpVersion.VersionReference)</dd>
                    <dt>Controls</dt><dd>@preview.Package.RmcpVersion.Controls.Count</dd>
                    <dt>Documents</dt><dd>@preview.Package.ControlledDocuments.Count</dd>
                    <dt>Evidence</dt><dd>@preview.Package.Evidence.Count</dd>
                    <dt>Live folder</dt><dd><code>@preview.MappedLiveRoot</code></dd>
                    <dt>Package</dt><dd><code>@preview.Package.PackageId</code></dd>
                </dl>

                @if (preview.MissingMappedFiles.Count > 0)
                {
                    <div class="alert alert-warning">
                        <strong>Mapped files not found on this server:</strong>
                        <ul class="mb-0">
                            @foreach (var path in preview.MissingMappedFiles)
                            {
                                <li><code>@path</code></li>
                            }
                        </ul>
                    </div>
                }
                @foreach (var warning in preview.Warnings)
                {
                    <div class="alert alert-warning">@warning</div>
                }
                @foreach (var conflict in preview.Conflicts)
                {
                    <div class="alert alert-danger">@conflict</div>
                }

                @if (preview.CanApply)
                {
                    <label>
                        Live import approval reason
                        <textarea class="form-control" @bind="importReason"></textarea>
                    </label>
                    <div class="form-check my-2">
                        <input class="form-check-input" type="checkbox" id="confirm-programme-transfer" @bind="confirmApply" />
                        <label class="form-check-label" for="confirm-programme-transfer">
                            I confirm this package is from the approved laptop KCAS and should update the live compliance programme records.
                        </label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="ApplyAsync"
                            disabled="@(isBusy || !confirmApply)">
                        Apply programme package
                    </button>
                }
            </div>
        }
    </article>
</section>

@code {
    private string exportReason = "Transfer signed RMCP/BRA programme bundle to live KCAS.";
    private string? exportPassphrase;
    private string? exportPassphraseConfirm;
    private ComplianceProgrammeTransferExportResult? exportResult;
    private byte[]? importBytes;
    private string? importFileName;
    private string? importPassphrase;
    private string importReason = "Approved signed RMCP/BRA programme transfer from laptop KCAS.";
    private ComplianceProgrammeTransferPreview? preview;
    private bool confirmApply;
    private bool isBusy;
    private bool isError;
    private string? statusMessage;

    private async Task ExportAsync()
    {
        if (exportPassphrase != exportPassphraseConfirm)
        {
            ShowError("The export passphrases do not match.");
            return;
        }

        await RunAsync(async user =>
        {
            exportResult = await TransferService.ExportAsync(exportPassphrase ?? "", user, exportReason);
            statusMessage = "Encrypted programme package created.";
        });
    }

    private async Task SelectImportFileAsync(InputFileChangeEventArgs args)
    {
        statusMessage = null;
        preview = null;
        confirmApply = false;
        var file = args.File;
        importFileName = file.Name;
        if (file.Size > 25 * 1024 * 1024)
        {
            importBytes = null;
            ShowError("The package exceeds the 25 MB safety limit.");
            return;
        }

        await using var stream = file.OpenReadStream(25 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        importBytes = memory.ToArray();
    }

    private async Task PreviewAsync()
    {
        await RunAsync(async _ =>
        {
            preview = await TransferService.PreviewAsync(importBytes!, importPassphrase ?? "");
            confirmApply = false;
            statusMessage = preview.CanApply
                ? "Preview complete. Confirm the package before applying."
                : "Preview complete with conflicts.";
            isError = !preview.CanApply;
        });
    }

    private async Task ApplyAsync()
    {
        await RunAsync(async user =>
        {
            var result = await TransferService.ApplyAsync(importBytes!, importPassphrase ?? "", user, importReason);
            statusMessage = $"Programme package applied: BRA {result.BusinessRiskAssessmentId}, " +
                $"RMCP {result.RmcpVersionId}, {result.ControlledDocumentCount} document(s), " +
                $"{result.EvidenceCount} evidence record(s).";
            preview = null;
            confirmApply = false;
        });
    }

    private async Task RunAsync(Func<string?, Task> action)
    {
        isBusy = true;
        isError = false;
        statusMessage = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await action(auth.User.Identity?.Name);
        }
        catch (ValidationException ex) { ShowError(ex.Message); }
        catch (InvalidOperationException ex) { ShowError(ex.Message); }
        catch (IOException ex) { ShowError(ex.Message); }
        finally { isBusy = false; }
    }

    private void ShowError(string message)
    {
        isError = true;
        statusMessage = message;
    }

    private static string FormatBytes(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024d:N0} KB"
        : $"{bytes / 1024d / 1024d:N1} MB";
}
