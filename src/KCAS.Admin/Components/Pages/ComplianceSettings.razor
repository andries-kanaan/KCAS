@page "/compliance/settings"
@page "/compliance/profile"
@page "/compliance/governance"
@page "/compliance/organisation"
@page "/compliance/documents"
@page "/compliance/references"
@page "/compliance/methodologies"
@page "/compliance/tasks"
@page "/compliance/evidence"
@page "/compliance/audit"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@implements IDisposable
@using KCAS.Admin.Data
@inject ComplianceService ComplianceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject DocumentPathDisplayService PathDisplay

<PageTitle>@PageHeading</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">@PageEyebrow</p>
        <h1>@PageHeading</h1>
        <p class="lede">@PageDescription</p>
    </div>
    <a class="btn btn-outline-secondary" href="/compliance">Dashboard</a>
</div>

<nav class="nav nav-tabs mb-4" aria-label="Compliance settings">
    <NavLink class="nav-link" href="/compliance/methodologies" Match="NavLinkMatch.All">Methodology</NavLink>
    <NavLink class="nav-link" href="/compliance/organisation" Match="NavLinkMatch.All">Organisation and governance</NavLink>
    <NavLink class="nav-link" href="/compliance/references" Match="NavLinkMatch.All">References</NavLink>
    <NavLink class="nav-link" href="/compliance/evidence" Match="NavLinkMatch.All">Evidence</NavLink>
    <NavLink class="nav-link" href="/compliance/tasks" Match="NavLinkMatch.All">Tasks</NavLink>
    <NavLink class="nav-link" href="/compliance/audit" Match="NavLinkMatch.All">Audit</NavLink>
</nav>

@if (model is null)
{
    <p>Loading compliance records...</p>
}
else
{
    @if (activeSection == "organisation")
    {
        <section class="work-area">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <h2>Organisation and governance</h2>
                    <p class="text-muted mb-0">The FSP identity, authorisation, leadership and compliance accountability recorded in KCAS.</p>
                </div>
                @if (canManage)
                {
                    <a class="btn btn-outline-primary" href="/compliance/organisation/update">Update</a>
                }
            </div>
            <dl class="mt-3">
                <dt>Legal name</dt><dd>@Display(profile.LegalName)</dd>
                <dt>Trading name</dt><dd>@Display(profile.TradingName)</dd>
                <dt>Legal form</dt><dd>Trust (IT 676/97)</dd>
                <dt>FSP number</dt><dd>@Display(profile.FspNumber)</dd>
                <dt>Accountable institution number</dt><dd>@Display(profile.AccountableInstitutionNumber)</dd>
                <dt>Status</dt><dd>@Display(profile.Status)</dd>
                <dt>Effective from</dt><dd>@Date(profile.EffectiveFrom)</dd>
                <dt>Registered address</dt><dd>@Display(profile.RegisteredAddress)</dd>
                <dt>Operating address</dt><dd>@Display(profile.OperatingAddress)</dd>
                <dt>Primary contact</dt><dd>@Display(profile.PrimaryContactName)</dd>
                <dt>Contact details</dt><dd>@Display(profile.PrimaryContactPhone) · @Display(profile.PrimaryContactEmail)</dd>
            </dl>
        </section>

        <section class="work-area">
            <h2>Authorisation and business profile</h2>
            <dl>
                <dt>Legal form</dt><dd>Trust (IT 676/97)</dd>
                <dt>Authorised FSP</dt><dd>FSP 528</dd>
                <dt>Licence categories</dt><dd>Category I, Category II and Category IIA</dd>
                <dt>Current services</dt><dd>Financial planning and advice; discretionary asset and fund management; tax planning; wills and testaments</dd>
                <dt>Website</dt><dd><a href="https://www.kanaantrust.com/" target="_blank" rel="noopener">www.kanaantrust.com</a></dd>
                <dt>General office</dt><dd>+27 31 561 2208 · secretary@kanaantrust.com</dd>
            </dl>
        </section>

        <section class="work-area">
            <h2>Governance structure and responsible persons</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Person</th><th>Position and regulated roles</th><th>Contact</th><th>Responsibility</th></tr></thead>
                    <tbody>
                        @foreach (var role in model.GovernanceRoles)
                        {
                            <tr>
                                <td><strong>@role.PersonName</strong></td>
                                <td>@role.RoleType</td>
                                <td>@Display(role.Email)<br /><span class="text-muted small">@Display(role.Phone)</span></td>
                                <td>@Display(role.ResponsibilitySummary)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (activeSection == "references")
    {
        <section class="work-area">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <h2>Recorded regulatory references</h2>
                    <p class="text-muted mb-0">The legislation, regulatory sources and internal reference codes used by the compliance programme.</p>
                </div>
                @if (canManage)
                {
                    <a class="btn btn-outline-primary" href="/compliance/references/update">Update</a>
                }
            </div>
            @RenderSimpleTable(model.ReferenceValues.Select(item => new[] { item.Category, item.Code, item.Name, item.Description ?? "-", item.IsActive ? "Active" : "Inactive" }))
        </section>
    }

    @if (activeSection == "methodologies")
    {
        <section class="work-area">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <h2>Methodology versions</h2>
                    <p class="text-muted mb-0">Open a version to review its factors, scoring options, risk bands, approval status and audit history.</p>
                </div>
                @if (canManage)
                {
                    <a class="btn btn-outline-primary" href="/compliance/methodologies/update">Update</a>
                }
            </div>
            @RenderMethodologies()
        </section>
    }

    @if (activeSection == "tasks")
    {
        <section class="work-area">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <h2>Monitoring and compliance tasks</h2>
                    <p class="text-muted mb-0">Review assigned actions, due dates and completion status used to evidence ongoing compliance monitoring.</p>
                </div>
                @if (canManage)
                {
                    <a class="btn btn-outline-primary" href="/compliance/tasks/update">Update</a>
                }
            </div>
            @RenderSimpleTable(model.Tasks.Select(item => new[] { item.Title, item.Description ?? "-", item.Owner ?? "-", Date(item.DueDate), item.Status }))
        </section>
    }

    @if (activeSection == "evidence")
    {
        <section class="work-area">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
            <div>
                <h2>Compliance evidence</h2>
                <p class="text-muted mb-0">Review submitted documents and supporting proof, including their source, verification date and validity.</p>
            </div>
            @if (canManage)
            {
                <a class="btn btn-outline-primary" href="/compliance/evidence/update">Update</a>
            }
        </div>
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead><tr><th>Type</th><th>Evidence</th><th>Source</th><th>Verified</th><th>Expiry</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in model.Evidence)
                    {
                        <tr>
                            <td>@item.EvidenceType</td>
                            <td><strong>@item.Title</strong><div class="text-muted small">@Display(PathDisplay.ForWorkstation(item.Location))</div></td>
                            <td>@Display(item.Source)</td>
                            <td>@Date(item.VerifiedDate)</td>
                            <td>@Date(item.ExpiryDate)</td>
                            <td class="text-end">
                                @if (!string.IsNullOrWhiteSpace(item.Location))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/compliance/evidence/{item.Id}/file")" target="_blank" rel="noopener">Open</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </section>
    }

    @if (activeSection == "audit")
    {
        <section class="work-area">
        <h2>Recorded compliance activity</h2>
        <p class="text-muted">A chronological record of controlled changes, responsible users and the reasons supplied for those changes.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>When</th><th>Entity</th><th>Action</th><th>User</th><th>Reason</th></tr></thead>
                <tbody>
                    @foreach (var audit in model.AuditEvents)
                    {
                        <tr>
                            <td>@audit.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@audit.EntityLabel</td>
                            <td>@audit.Action</td>
                            <td>@Display(audit.UserName)</td>
                            <td>@audit.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </section>
    }
}

@code {
    private string activeSection = "organisation";
    private string PageEyebrow => activeSection switch
    {
        "methodologies" => "Risk framework",
        "organisation" => "FSP record",
        "references" => "Regulatory framework",
        "evidence" => "Compliance records",
        "tasks" => "Ongoing monitoring",
        "audit" => "Accountability",
        _ => "Compliance"
    };
    private string PageHeading => activeSection switch
    {
        "methodologies" => "Risk methodology",
        "organisation" => "Organisation and governance",
        "references" => "Regulatory references",
        "evidence" => "Evidence register",
        "tasks" => "Monitoring and tasks",
        "audit" => "Compliance audit trail",
        _ => "Compliance"
    };
    private string PageDescription => activeSection switch
    {
        "methodologies" => "The approved approach used to assess client risk, including factors, scoring and review frequency.",
        "organisation" => "Kanaan's FSP identity, authorisation, leadership and compliance accountability.",
        "references" => "The external obligations and internal classifications on which the compliance programme relies.",
        "evidence" => "The source documents and proof retained to demonstrate operation of the compliance programme.",
        "tasks" => "Assigned compliance actions, due dates and status for ongoing monitoring.",
        "audit" => "The immutable history of controlled compliance changes recorded in KCAS.",
        _ => "Kanaan compliance records."
    };

    private void SetActiveSection()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var path = relativePath.Split('?', '#')[0].Trim('/');
        var section = path.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        activeSection = section is "profile" or "governance" or "organisation"
            ? "organisation"
            : section is "references" or
            "methodologies" or "tasks" or "evidence" or "audit"
            ? section
            : section == "documents" ? "evidence" : "methodologies";
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SetActiveSection();
        _ = InvokeAsync(StateHasChanged);
    }

    private ComplianceManageModel? model;
    private ComplianceProfileModel profile = new();
    private bool canManage;

    protected override async Task OnInitializedAsync()
    {
        SetActiveSection();
        NavigationManager.LocationChanged += HandleLocationChanged;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canManage = authState.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceManage);
        await LoadAsync();
    }

    public void Dispose() =>
        NavigationManager.LocationChanged -= HandleLocationChanged;

    private async Task LoadAsync()
    {
        model = await ComplianceService.LoadManageModelAsync();
        profile = model.Profile;
    }

    private RenderFragment RenderSimpleTable(IEnumerable<string[]> rows) => builder =>
    {
        var index = 0;
        builder.OpenElement(index++, "div");
        builder.AddAttribute(index++, "class", "table-responsive mt-3");
        builder.OpenElement(index++, "table");
        builder.AddAttribute(index++, "class", "table align-middle");
        builder.OpenElement(index++, "tbody");
        foreach (var row in rows)
        {
            builder.OpenElement(index++, "tr");
            foreach (var cell in row)
            {
                builder.OpenElement(index++, "td");
                builder.AddContent(index++, cell);
                builder.CloseElement();
            }
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment RenderMethodologies() => builder =>
    {
        if (model is null) { return; }
        var index = 0;
        builder.OpenElement(index++, "div");
        builder.AddAttribute(index++, "class", "table-responsive mt-3");
        builder.OpenElement(index++, "table");
        builder.AddAttribute(index++, "class", "table align-middle");
        builder.OpenElement(index++, "tbody");
        foreach (var item in model.Methodologies)
        {
            builder.OpenElement(index++, "tr");
            builder.OpenElement(index++, "td");
            builder.AddContent(index++, item.Name);
            builder.CloseElement();
            builder.OpenElement(index++, "td");
            builder.AddContent(index++, item.Status);
            builder.CloseElement();
            builder.OpenElement(index++, "td");
            builder.AddContent(index++, $"{item.Factors.Count} factor(s), {item.Bands.Count} band(s)");
            builder.CloseElement();
            builder.OpenElement(index++, "td");
            builder.AddAttribute(index++, "class", "text-end");
            builder.OpenElement(index++, "a");
            builder.AddAttribute(index++, "class", "btn btn-sm btn-outline-secondary");
            builder.AddAttribute(index++, "href", $"/compliance/methodologies/{item.Id}/review");
            builder.AddContent(index++, "Review details");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Date(DateOnly? value) => value is null ? "-" : value.Value.ToString("yyyy-MM-dd");
}
