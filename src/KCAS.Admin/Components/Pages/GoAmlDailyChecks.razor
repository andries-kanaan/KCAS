@page "/compliance/goaml"
@rendermode InteractiveServer
@implements IAsyncDisposable
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@inject GoAmlDailyCheckService GoAml
@inject GoAmlReminderService Reminders
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>goAML check</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Compliance</p>
        <h1>goAML check</h1>
        <p class="lede">goAML access and message follow-up.</p>
    </div>
    <div class="d-flex gap-2">
        @if (isAdministrator)
        {
            <a class="btn btn-outline-primary" href="/compliance/goaml/transfers">Transfer checks</a>
        }
        <a class="btn btn-outline-secondary" href="/compliance">Compliance dashboard</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-info")">@message</div>
}

@if (dashboard is null)
{
    <p>Loading goAML check...</p>
}
else
{
    @if (dashboard.IsTodayComplete)
    {
        <div class="alert alert-success">Today's goAML access is recorded.</div>
    }

    <section class="work-area">
        <div class="page-header compact-header">
            <div>
                <h2>Current check</h2>
                <p class="text-muted mb-0">Weekday checks by @dashboard.Settings.DueHourLocal.ToString("00"):00 South African time (Monday-Friday).</p>
            </div>
            @if (canManage)
            {
                <div class="d-flex flex-wrap gap-2">
                <form method="post" action="/compliance/goaml/open" target="_blank" rel="noopener">
                    <AntiforgeryToken />
                    <button class="btn btn-primary" type="submit">Open goAML</button>
                </form>
                <button class="btn btn-outline-primary" type="button" @onclick="SendEmailAsync" disabled="@(isBusy || isLoading)">Send goAML email</button>
                </div>
            }
        </div>

        @if (dashboard.TodayCheck is not null)
        {
            <div class="investment-summary mt-3">
                <div><span>Date</span><strong>@dashboard.TodayCheck.CheckDate.ToString("yyyy-MM-dd")</strong></div>
                <div><span>Status</span><strong>@GoAmlCheckStatuses.Display(dashboard.TodayCheck.Status)</strong></div>
                <div><span>Recorded by: </span><strong>@(dashboard.TodayCheck.CompletedBy ?? dashboard.TodayCheck.StartedBy)</strong></div>
                <div><span>Recorded at: </span><strong>@LocalTime(dashboard.TodayCheck.CompletedAtUtc ?? dashboard.TodayCheck.StartedAtUtc)</strong></div>
            </div>
        }

        @if (canManage && dashboard.TodayCheck is not null &&
            (dashboard.TodayCheck.Status == GoAmlCheckStatuses.Started || dashboard.TodayCheck.Status == GoAmlCheckStatuses.AccessRecorded))
        {
            <details class="mt-3">
            <summary>Record message outcome or access problem (optional)</summary>
            <div class="workspace-grid mt-3">
                <select class="form-select" @bind="completion.Status">
                    <option value="@GoAmlCheckStatuses.NoNewMessages">No new or actionable messages</option>
                    <option value="@GoAmlCheckStatuses.ActionRequired">New message - action required</option>
                    <option value="@GoAmlCheckStatuses.Unavailable">goAML unavailable</option>
                </select>
            </div>
            @if (completion.Status == GoAmlCheckStatuses.ActionRequired)
            {
                <div class="workspace-grid mt-2">
                    <input class="form-control" @bind="completion.MessageReference" placeholder="Message subject or reference" />
                    <input class="form-control" @bind="completion.ActionOwner" placeholder="Action owner" />
                    <InputDate class="form-control" @bind-Value="completion.ActionDueDate" />
                </div>
                <p class="form-text">KCAS creates a High-priority compliance work item automatically.</p>
            }
            <textarea class="form-control mt-2" rows="3" @bind="completion.Notes" placeholder="Notes, action summary or access problem"></textarea>
            <button class="btn btn-success mt-2" @onclick="CompleteTodayAsync" disabled="@isBusy">Record outcome</button>
            </details>
        }
    </section>

    @if (reminderStatus is not null)
    {
        <section class="work-area">
            <h2>Email reminder</h2>
            <p>@reminderStatus.Description</p>
            @if (reminderStatus.Latest is { } delivery)
            {
                <p>Latest reminder: @delivery.ReminderDate.ToString("yyyy-MM-dd") · @delivery.Status
                    @if (delivery.SentAtUtc is { } sent) { <span> · @LocalTime(sent)</span> }
                </p>
                @if (delivery.Error is not null) { <p class="text-danger">@delivery.Error</p> }
            }
        </section>
    }

    <section class="work-area">
        <h2>Recent checks</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Outcome</th><th>Recorded by</th><th>Recorded at (SA)</th><th>Previous evidence</th><th>Message/action</th></tr></thead>
                <tbody>
                    @foreach (var check in dashboard.RecentChecks)
                    {
                        <tr class="@(check.Status == GoAmlCheckStatuses.ActionRequired ? "table-warning" : "")">
                            <td>@check.CheckDate.ToString("yyyy-MM-dd")</td>
                            <td>@GoAmlCheckStatuses.Display(check.Status)</td>
                            <td>@(check.CompletedBy ?? check.StartedBy)</td>
                            <td>@LocalTime(check.CompletedAtUtc ?? check.StartedAtUtc)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(check.EvidencePath))
                                {
                                    <a href="@($"/compliance/goaml/checks/{check.Id}/evidence")" target="_blank" rel="noopener">View screenshot</a>
                                    <div class="small text-muted">@check.EvidenceSha256</div>
                                }
                                else { <span>-</span> }
                            </td>
                            <td>
                                @(check.MessageReference ?? check.Notes ?? "-")
                                @if (check.ComplianceTaskId is not null)
                                {
                                    <div><a href="@($"/compliance/work-register/{check.ComplianceTaskId}")">Open work item</a></div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (canManage)
    {
        <section class="work-area">
            <h2>goAML settings</h2>
            <div class="workspace-grid mt-2">
                <div>
                    <label class="form-label">Official portal URL</label>
                    <input class="form-control" @bind="settings.PortalUrl" />
                </div>
                <div>
                    <label class="form-label">Access tracking starts</label>
                    <InputDate class="form-control" @bind-Value="settings.TrackingStartDate" />
                </div>
                <div>
                    <label class="form-label">Due hour (South African time, 0–23)</label>
                    <InputNumber class="form-control" @bind-Value="settings.DueHourLocal" />
                </div>
                <div>
                    <label class="form-label">Backup checker</label>
                    <input class="form-control" @bind="settings.BackupChecker" />
                </div>
            </div>
            <input class="form-control mt-2" @bind="settingsReason" placeholder="Reason for changing goAML settings" />
            <button class="btn btn-outline-primary mt-2" @onclick="SaveSettingsAsync" disabled="@isBusy">Save settings</button>
        </section>
    }
}

@code {
    private GoAmlDashboardModel? dashboard;
    private GoAmlSettingsModel settings = new();
    private GoAmlCompletionModel completion = new();
    private string? currentUser;
    private string settingsReason = "Configure goAML daily access.";
    private GoAmlReminderStatus? reminderStatus;
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private string? message;
    private bool isError;
    private bool isBusy;
    private bool isLoading;
    private bool canManage;
    private bool isAdministrator;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name;
        canManage = state.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceManage);
        isAdministrator = state.User.IsInRole(KcasRoles.Administrator);
        completion.ActionOwner = currentUser;
        await LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) refreshTask = RefreshAsync();
        return Task.CompletedTask;
    }

    private async Task RefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
                await InvokeAsync(async () => { if (!isBusy && !isLoading) { await LoadAsync(false); StateHasChanged(); } });
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
    }

    private async Task LoadAsync(bool reloadSettings = true)
    {
        isLoading = true;
        try
        {
            dashboard = await GoAml.LoadDashboardAsync();
            reminderStatus = await Reminders.LoadStatusAsync();
            if (reloadSettings) settings = dashboard.Settings;
        }
        finally { isLoading = false; }
    }

    private async Task CompleteTodayAsync()
    {
        if (!canManage || isBusy || isLoading) return;
        try
        {
            isBusy = true;
            await GoAml.CompleteTodayAsync(completion, null, null, currentUser, "Recorded goAML message-board outcome.");
            message = "goAML check was recorded.";
            isError = false;
            await LoadAsync();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { isBusy = false; }
    }

    private async Task SendEmailAsync()
    {
        if (!canManage || isBusy || isLoading) return;
        isBusy = true;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            message = await Reminders.SendManualAsync(state.User, refreshCancellation.Token);
            isError = false;
        }
        catch (Exception ex) { ShowError(ex); }
        finally { isBusy = false; }
    }

    private async Task SaveSettingsAsync()
    {
        if (!canManage || isBusy || isLoading) return;
        try
        {
            isBusy = true;
            await GoAml.SaveSettingsAsync(settings, currentUser, settingsReason);
            message = "goAML settings saved.";
            isError = false;
            await LoadAsync();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { isBusy = false; }
    }

    private void ShowError(Exception ex)
    {
        message = ex.Message;
        isError = true;
    }

    private static string LocalTime(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc)
        .AddHours(2).ToString("yyyy-MM-dd HH:mm:ss");

    public async ValueTask DisposeAsync()
    {
        await refreshCancellation.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        refreshCancellation.Dispose();
    }
}
