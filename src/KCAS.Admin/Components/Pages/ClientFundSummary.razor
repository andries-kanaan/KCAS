@page "/clients/{ClientId:int}/fund-summary"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.InvestmentsView)]
@using KCAS.Admin.Data
@inject ClientOperationsService ClientOperations

<PageTitle>Fund summary</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Investment workflow</p>
        <h1>Fund summary</h1>
        <p class="text-muted mb-0">@Display(summary?.ClientDisplayName)</p>
    </div>
    <a class="btn btn-outline-secondary" href="@($"/clients/{ClientId}#investments")">Back to client</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-warning">@statusMessage</div>
}
else if (summary is not null)
{
    <section class="detail-panel">
        <div class="notes-toolbar">
            <input class="form-control" value="@filter" @oninput="FilterAsync" aria-label="Filter fund summary" placeholder="Filter funds" />
            <div class="note-count">@summary.Rows.Count row@(summary.Rows.Count == 1 ? "" : "s")</div>
        </div>
        <div class="investment-summary">
            <div>
                <span>Total ZAR</span>
                <strong>@Money(summary.TotalCurrentValueZar)</strong>
            </div>
            <div>
                <span>Matched valuations</span>
                <strong>@summary.MatchedValuationCount</strong>
            </div>
            <div>
                <span>Historical accounts</span>
                <strong>@summary.HistoricalAccountCount</strong>
            </div>
            <div>
                <span>Status corrections</span>
                <strong>@summary.StatusCorrectionCount</strong>
            </div>
            <div>
                <span>Unmatched valuations</span>
                <strong>@summary.UnmatchedValuationCount</strong>
            </div>
            <div>
                <span>Latest value date</span>
                <strong>@Date(summary.LatestValueDate)</strong>
            </div>
        </div>
        @if (summary.CurrentRows.Count == 0)
        {
            <p class="text-muted">No current investment values match this filter.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Account</th>
                        <th>Administrator</th>
                        <th>Product</th>
                        <th>Fund</th>
                        <th>Value</th>
                        <th>Source</th>
                        <th>Transactions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in summary.CurrentRows)
                    {
                        <tr>
                            <td>@Display(row.AccountNumber)</td>
                            <td>@Display(row.Administrator)</td>
                            <td>
                                @Display(row.ProductName)
                                <div class="text-muted small">@Display(row.ProductType)</div>
                            </td>
                            <td>@Display(row.FundName)</td>
                            <td>
                                @if (row.CurrentValueForeign.HasValue && row.CurrentValueForeign.Value != 0)
                                {
                                    <div><strong>@ForeignMoney(row.CurrentValueForeign, row.ForeignCurrencyCode)</strong></div>
                                    <div class="text-muted small">@Money(row.CurrentValueZar) converted ZAR</div>
                                }
                                else
                                {
                                    <div>@Money(row.CurrentValueZar)</div>
                                }
                                <div class="text-muted small">@Date(row.CurrentValueDate)</div>
                            </td>
                            <td>@row.Source</td>
                            <td>@row.TransactionCount</td>
                        </tr>
                    }
                </tbody>
                </table>
            </div>
        }
        @if (summary.HistoricalRows.Count > 0)
        {
            <details class="mt-3">
                <summary>
                    Historical investments (@summary.HistoricalRows.Count)
                    @if (summary.StatusCorrectionCount > 0)
                    {
                        <span class="badge text-bg-warning ms-2">@summary.StatusCorrectionCount need status correction</span>
                    }
                </summary>
                @if (summary.StatusCorrectionCount > 0)
                {
                    <div class="alert alert-warning mt-2">
                        Accounts without a current value or an effective surrender date require correction.
                    </div>
                }
                <div class="table-responsive mt-2">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Account</th>
                                <th>Administrator</th>
                                <th>Product</th>
                                <th>Fund</th>
                                <th>Last recorded value</th>
                                <th>Historical reason</th>
                                <th>Transactions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in summary.HistoricalRows)
                            {
                                <tr class="@(row.NeedsStatusCorrection ? "table-warning" : "")">
                                    <td>@Display(row.AccountNumber)</td>
                                    <td>@Display(row.Administrator)</td>
                                    <td>
                                        @Display(row.ProductName)
                                        <div class="text-muted small">@Display(row.ProductType)</div>
                                    </td>
                                    <td>@Display(row.FundName)</td>
                                    <td>
                                        @if (row.CurrentValueForeign.HasValue && row.CurrentValueForeign.Value != 0)
                                        {
                                            <div><strong>@ForeignMoney(row.CurrentValueForeign, row.ForeignCurrencyCode)</strong></div>
                                            <div class="text-muted small">@Money(row.CurrentValueZar) converted ZAR</div>
                                        }
                                        else
                                        {
                                            <div>@Money(row.CurrentValueZar)</div>
                                        }
                                        <div class="text-muted small">@Date(row.CurrentValueDate)</div>
                                    </td>
                                    <td>
                                        <div>@row.StatusReason</div>
                                        @if (row.NeedsStatusCorrection)
                                        {
                                            <span class="badge text-bg-warning">Correction required</span>
                                        }
                                    </td>
                                    <td>@row.TransactionCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </section>
}

@code {
    [Parameter]
    public int ClientId { get; set; }

    private ClientFundSummaryModel? summary;
    private string? filter;
    private string? statusMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            summary = await ClientOperations.LoadFundSummaryAsync(ClientId, filter);
        }
        catch (InvalidOperationException ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task FilterAsync(ChangeEventArgs args)
    {
        filter = args.Value?.ToString();
        await LoadAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Not captured" : value;

    private static string Money(decimal? value) => value is null ? "Not captured" : value.Value.ToString("C");

    private static string ForeignMoney(decimal? value, string? currencyCode) =>
        value is null ? "Not captured" : $"{currencyCode ?? "Foreign"} {value.Value:N2}";

    private static string Date(DateOnly? value) => value is null ? "Not captured" : value.Value.ToString("yyyy-MM-dd");
}
