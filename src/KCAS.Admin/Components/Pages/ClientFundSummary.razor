@page "/clients/{ClientId:int}/fund-summary"
@attribute [Authorize(Policy = KcasPermissions.InvestmentsView)]
@inject NavigationManager Navigation

<PageTitle>Investment Summary</PageTitle>

@code {
    [Parameter]
    public int ClientId { get; set; }

    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/investments/summary?clientId={ClientId}", replace: true);
    }
}
