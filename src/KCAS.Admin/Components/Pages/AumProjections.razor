@page "/investments/aum-projections"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPolicies.ApprovedAccount)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using KCAS.Admin.Data
@inject AumProjectionService Projections
@inject AuthenticationStateProvider Authentication
@inject ILogger<AumProjections> Logger

<PageTitle>AUM projections</PageTitle>
<div class="page-header"><h1>AUM projections</h1></div>
@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (notice is not null)
{
    <div class="alert alert-success" role="status">@notice</div>
}
<ul class="nav nav-tabs mb-3" aria-label="Projection views">
    @foreach (var tab in Tabs)
    {
        <li class="nav-item"><button type="button" class="nav-link @(view == tab ? "active" : "")"
            aria-pressed="@(view == tab)" disabled="@busy" @onclick="() => view = tab">@tab</button></li>
    }
</ul>
@if (view == AumProjectionTables.Inputs)
{
    <section class="work-area">
        <h2>Input snapshot</h2>
        @if (snapshot is not null)
        {
            <p><strong>@Date(snapshot.AsOf)</strong> &middot; @snapshot.Holdings holdings &middot; Opening AUM: @Rand(snapshot.Opening)</p>
            <p class="text-break">@snapshot.Source</p>
        }
        else if (!busy)
        {
            <p>No input snapshot has been imported.</p>
        }
        @if (CanImport)
        {
            <fieldset disabled="@busy">
                <label class="form-label" for="aum-snapshot">Prepared AUM snapshot (.json)</label>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <InputFile id="aum-snapshot" class="form-control w-auto mw-100" accept=".json" OnChange="SelectFile" @key="fileKey" />
                    <button type="button" class="btn btn-outline-primary" disabled="@(selectedFile is null)" @onclick="Import">Import snapshot</button>
                </div>
            </fieldset>
        }
    </section>
    @if (snapshot is not null)
    {
        <section class="work-area">
            <h2>Return assumptions</h2>
            <p class="text-muted">Equity Offshore and IBKR are modelled separately within the existing EO wrapper. No merger or additional opening AUM is assumed.</p>
            <fieldset disabled="@busy">
                <div class="form-check mb-3">
                    <input id="aum-custom" type="checkbox" class="form-check-input" @bind="custom" />
                    <label class="form-check-label" for="aum-custom">Use custom CARs</label>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th scope="col">Fund</th><th scope="col">Basis</th><th scope="col" class="text-end">Default CAR</th><th scope="col">Custom CAR (%)</th></tr></thead>
                        <tbody>
                        @foreach (var row in rates)
                        {
                            <tr @key="row.Fund.Name">
                                <th scope="row">@row.Fund.Name</th><td>@row.Fund.Basis</td><td class="text-end">@Percent(row.Fund.Car)</td>
                                <td>
                                    @if (row.Fund.Name == AumProjectionEngine.MoriahUsd)
                                    {
                                        <span class="text-muted">Follows Moriah Global</span>
                                    }
                                    else
                                    {
                                        <input type="number" class="form-control form-control-sm" style="max-width: 9rem"
                                            aria-label="@($"{row.Fund.Name} custom CAR in percent")" min="-80" max="200" step="any"
                                            disabled="@(!custom)" @bind="row.CustomPercent" />
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <label class="form-label" for="aum-name">Scenario name</label>
                <input id="aum-name" class="form-control mb-3" style="max-width: 28rem" maxlength="120" @bind="name" />
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" @onclick="Preview">Run projection</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Reset">Reset to defaults</button>
                </div>
            </fieldset>
        </section>
        <AumProjectionGrid Table="@AumProjectionTables.Assumptions(snapshot.Assumptions)" />
    }
}
else if (view == "Saved runs")
{
    <section class="work-area">
        <h2>Saved runs</h2>
        @if (saved.Length == 0)
        {
            <p>No saved runs.</p>
        }
        else
        {
            <div class="table-responsive"><table class="table table-sm">
                <thead><tr><th scope="col">Scenario</th><th scope="col">Saved (UTC)</th><th scope="col">Saved by</th><th scope="col">Actions</th></tr></thead>
                <tbody>
                @foreach (var item in saved)
                {
                    <tr><th scope="row">@item.Name</th><td>@item.At.ToString("yyyy-MM-dd HH:mm")</td><td>@item.Actor</td><td>
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="() => Open(item.Id)">Open</button>
                        <a class="btn btn-sm btn-outline-secondary" href="@Report(item.Id, "xlsx")">Excel</a>
                        <a class="btn btn-sm btn-outline-secondary" href="@Report(item.Id, "pdf")">PDF</a>
                    </td></tr>
                }
                </tbody>
            </table></div>
        }
    </section>
}
else if (run is not null)
{
    <p class="text-muted text-break">@run.Name &middot; Snapshot @Date(run.AsOf) &middot; ZAR</p>
    @if (view == AumProjectionTables.Business)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (runId is long id)
            {
                <a class="btn btn-outline-primary" href="@Report(id, "xlsx")">Download Excel</a>
                <a class="btn btn-outline-secondary" href="@Report(id, "pdf")">Download summary PDF</a>
            }
            else
            {
                <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="Save">Save projection</button>
            }
        </div>
        @if (run.Assumptions?.BusinessBaseline is null)
        {
            <p class="text-muted">Some baseline figures were not included in this snapshot.</p>
        }
        <p class="text-muted">A profitable receipt month does not establish recurring break-even.</p>
    }
    @if (view is AumProjectionTables.Funds or AumProjectionTables.Support or AumProjectionTables.Offshore)
    {
        <label class="form-label" for="aum-detail-month">Forecast period</label>
        <select id="aum-detail-month" class="form-select mb-3" style="max-width: 13rem" @bind="detailMonth">
            @for (var i = 0; i < run.Active.Months.Length; i++)
            {
                <option value="@i">@Date(run.Active.Months[i].End)</option>
            }
        </select>
    }
    @if (view == AumProjectionTables.Mortality)
    {
        <p class="text-muted">Only evidenced eligible voluntary shares enter this estimate. Individual death dates and unproven ownership shares are not inferred.</p>
    }
    @foreach (var table in AumProjectionTables.For(run, view, detailMonth))
    {
        <AumProjectionGrid Table="@table" />
    }
}
else if (!busy)
{
    <p>No projection to display. <button type="button" class="btn btn-link p-0 align-baseline" @onclick="() => view = AumProjectionTables.Inputs">Open inputs</button></p>
}

@code {
    private static readonly string[] Tabs = [.. AumProjectionTables.SheetNames, "Saved runs"];
    private string view = AumProjectionTables.Business, name = "Default forecast";
    private bool busy, custom;
    private string? error, notice;
    private ClaimsPrincipal user = new();
    private bool CanImport => user.IsInRole(KcasRoles.Administrator);
    private AumSnapshotInfo? snapshot;
    private AumSavedProjection? run;
    private AumSavedRunInfo[] saved = [];
    private RateEntry[] rates = [];
    private long? runId;
    private IBrowserFile? selectedFile;
    private int fileKey, detailMonth;

    protected override async Task OnInitializedAsync() => await Work(async () =>
    {
        user = (await Authentication.GetAuthenticationStateAsync()).User;
        SetSnapshot(await Projections.LatestAsync(user));
        if (snapshot is not null) await RunPreview([]);
        else view = AumProjectionTables.Inputs;
        saved = await Projections.RecentAsync(user);
    });

    private void SelectFile(InputFileChangeEventArgs e) => selectedFile = e.File;

    private Task Import() => Work(async () =>
    {
        if (selectedFile is null) return;
        using var reader = new StreamReader(selectedFile.OpenReadStream(AumProjectionService.MaxSnapshotBytes));
        var imported = await Projections.ImportAsync(await reader.ReadToEndAsync(), user);
        SetSnapshot(imported);
        await RunPreview([]);
        selectedFile = null;
        fileKey++;
        notice = $"Imported the snapshot dated {Date(imported.AsOf)}.";
    });

    private void SetSnapshot(AumSnapshotInfo? value)
    {
        snapshot = value;
        rates = value?.Funds.Select(f => new RateEntry(f)).ToArray() ?? [];
        name = "Default forecast";
        custom = false;
        run = null;
        runId = null;
    }

    private Task Reset() => Work(async () =>
    {
        custom = false;
        foreach (var row in rates) row.CustomPercent = null;
        name = "Default forecast";
        await RunPreview([]);
        notice = "Workbook defaults restored.";
    });

    private Task Preview() => Work(async () =>
    {
        if (snapshot is null) return;
        var changes = custom ? rates.Where(r => r.CustomPercent.HasValue)
            .ToDictionary(r => r.Fund.Name, r => r.CustomPercent!.Value / 100, StringComparer.Ordinal) : [];
        await RunPreview(changes);
    });

    private async Task RunPreview(Dictionary<string, double> changes)
    {
        if (snapshot is null) return;
        run = await Projections.PreviewAsync(snapshot.Id, name, changes, user);
        runId = null;
        detailMonth = 0;
        view = AumProjectionTables.Business;
    }

    private Task Save() => Work(async () =>
    {
        if (run is null || runId is not null) return;
        runId = await Projections.SaveAsync(run.SnapshotId, run.Name, run.Overrides, user);
        saved = await Projections.RecentAsync(user);
        notice = "Projection saved.";
    });

    private Task Open(long id) => Work(async () =>
    {
        run = await Projections.LoadAsync(id, user) ?? throw new ValidationException("This saved run is not available.");
        runId = id;
        detailMonth = 0;
        view = AumProjectionTables.Business;
    });

    private async Task Work(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        error = notice = null;
        try { await action(); }
        catch (ValidationException ex) { error = ex.Message; }
        catch (IOException) { error = "The snapshot could not be read. Check the file and its size (maximum 12 MB)."; }
        catch (UnauthorizedAccessException ex) { error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AUM projection action failed");
            error = "The projection action could not be completed. Check the KCAS log.";
        }
        finally { busy = false; }
    }

    private sealed class RateEntry(AumFund fund)
    {
        public AumFund Fund { get; } = fund;
        public double? CustomPercent { get; set; }
    }

    private static string Date(DateOnly date) => date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    private static string Rand(double value) => value.ToString("N0", CultureInfo.InvariantCulture);
    private static string Percent(double value) => value.ToString("0.####%", CultureInfo.InvariantCulture);
    private static string Report(long id, string format) => $"/aum-projections/runs/{id}/{format}";
}
