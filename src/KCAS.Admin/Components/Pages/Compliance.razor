@page "/compliance"
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@inject ComplianceService ComplianceService
@inject GoAmlDailyCheckService GoAml

<PageTitle>Compliance</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Compliance</h1>
        <p class="lede">Controlled configuration, responsible roles, document reviews, methodology status and audit evidence.</p>
    </div>
    <div class="header-actions">
        <AuthorizeView Policy="@KcasPermissions.ClientsView">
            <Authorized>
                <a class="btn btn-primary" href="/clients/operational-review">Continue client reviews</a>
            </Authorized>
        </AuthorizeView>
        <a class="btn btn-outline-primary" href="/compliance/goaml">goAML check</a>
        <AuthorizeView Policy="@KcasPermissions.ComplianceManage">
            <Authorized>
                <a class="btn btn-outline-secondary" href="/compliance/organisation">Settings</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (dashboard is null)
{
    <p>Loading compliance dashboard...</p>
}
else
{
    <section class="summary-grid">
        <article class="summary-card">
            <span>1. Risk methodology</span>
            <strong>Factors, scores and risk bands</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/methodologies">Open methodology</a>
        </article>
        <article class="summary-card">
            <span>2. Business risk assessment</span>
            <strong>Entity-wide risk and annual review</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/business-risk">Open BRA</a>
        </article>
        <article class="summary-card">
            <span>3. RMCP and controls</span>
            <strong>Approved programme and control operation</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/rmcp">Open RMCP</a>
        </article>
        <article class="summary-card">
            <span>4. Organisation and governance</span>
            <strong>FSP identity, responsible persons and accountability</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/organisation">Open organisation record</a>
        </article>
        <article class="summary-card">
            <span>5. Evidence register</span>
            <strong>Submitted documents and supporting proof</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/evidence">Open evidence</a>
        </article>
        <AuthorizeView Policy="@KcasPermissions.ClientsView">
            <Authorized>
                <article class="summary-card">
                    <span>Client reviews</span>
                    <strong>Unified client workflow</strong>
                    <a class="btn btn-sm btn-outline-primary mt-3" href="/clients/operational-review">Open reviews</a>
                </article>
            </Authorized>
        </AuthorizeView>
        <article class="summary-card">
            <span>goAML check</span>
            <strong>Recordings and checks</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/goaml">Open goAML check</a>
        </article>
        <AuthorizeView Policy="@KcasPermissions.InspectionsView">
            <Authorized>
                <article class="summary-card">
                    <span>Inspection response</span>
                    <strong>Regulator requests and frozen response packs</strong>
                    <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/inspections">Open response workspace</a>
                </article>
            </Authorized>
        </AuthorizeView>
    </section>

    <section class="work-area">
        @if (goAml is not null)
        {
            <div class="alert @(goAml.IsTodayComplete ? "alert-success" : "alert-info") mb-0">
                <strong>goAML check:</strong>
                @if (goAml.IsOverdue)
                {
                    <span>Recordings and evidence need attention soon.</span>
                }
                else if (goAml.IsTodayComplete)
                {
                    <span>Current check is complete.</span>
                }
                else
                {
                    <span>Record the current check when ready.</span>
                }
                <a class="alert-link ms-2" href="/compliance/goaml">Open goAML check</a>
            </div>
        }
    </section>

    <section class="work-area">
        <div class="investment-summary">
            <div>
                <span>Profile</span>
                <strong>@(dashboard.Profile?.Status ?? "Not captured")</strong>
            </div>
            <div>
                <span>Active methodology</span>
                <strong>@(dashboard.ActiveMethodology?.Name ?? "None")</strong>
            </div>
            <div>
                <span>Pending approvals</span>
                <strong>@dashboard.PendingApprovals</strong>
            </div>
            <div>
                <span>Open tasks</span>
                <strong>@dashboard.OpenTasks</strong>
            </div>
        </div>
    </section>

    <section class="work-area">
        <h2>Upcoming document reviews</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>Review date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in dashboard.UpcomingDocuments)
                    {
                        <tr>
                            <td>
                                <strong>@document.Title</strong>
                                <div class="text-muted small">@document.DocumentType</div>
                            </td>
                            <td>@Display(document.Owner)</td>
                            <td>@document.Status</td>
                            <td>@Date(document.NextReviewDate)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (dashboard.SignedFinalEvidence.Count > 0)
    {
        <section class="work-area">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <div>
                    <h2 class="mb-1">Signed-final FSCA evidence</h2>
                    <p class="text-muted mb-0">The submitted programme documents and supporting evidence, with direct access to each captured source.</p>
                </div>
                <AuthorizeView Policy="@KcasPolicies.AdministratorOnly">
                    <Authorized>
                        <a class="btn btn-sm btn-outline-primary" href="/compliance/programme-transfers">Transfer programme pack</a>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Evidence</th>
                            <th>Verified</th>
                            <th>Expiry</th>
                            <th>Evidence note</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evidence in dashboard.SignedFinalEvidence)
                        {
                            <tr>
                                <td>
                                    <strong>@evidence.Title</strong>
                                    <div class="text-muted small">@evidence.EvidenceType</div>
                                    <div class="text-muted small">@Display(evidence.Location)</div>
                                </td>
                                <td>@Date(evidence.VerifiedDate)</td>
                                <td>@Date(evidence.ExpiryDate)</td>
                                <td>@Display(evidence.Notes)</td>
                                <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@($"/compliance/evidence/{evidence.Id}/file")" target="_blank" rel="noopener">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <section class="work-area">
        <h2>Recent audit</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Entity</th>
                        <th>Action</th>
                        <th>User</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audit in dashboard.RecentAudit)
                    {
                        <tr>
                            <td>@audit.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@audit.EntityLabel</td>
                            <td>@audit.Action</td>
                            <td>@Display(audit.UserName)</td>
                            <td>@audit.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private ComplianceDashboardModel? dashboard;
    private GoAmlDashboardModel? goAml;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await ComplianceService.LoadDashboardAsync();
        goAml = await GoAml.LoadDashboardAsync();
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Date(DateOnly? value) => value is null ? "-" : value.Value.ToString("yyyy-MM-dd");
}
