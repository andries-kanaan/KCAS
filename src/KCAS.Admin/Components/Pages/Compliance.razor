@page "/compliance"
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@inject ComplianceService ComplianceService
@inject GoAmlDailyCheckService GoAml

<PageTitle>Compliance</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Administration</p>
        <h1>Compliance</h1>
        <p class="lede">Controlled configuration, responsible roles, document reviews, methodology status and audit evidence.</p>
    </div>
    <div class="header-actions">
        <AuthorizeView Policy="@KcasPermissions.ClientsView">
            <Authorized>
                <a class="btn btn-primary" href="/clients/operational-review">Continue client reviews</a>
            </Authorized>
        </AuthorizeView>
        <a class="btn btn-outline-primary" href="/compliance/goaml">Daily compliance</a>
        <AuthorizeView Policy="@KcasPermissions.ComplianceManage">
            <Authorized>
                <a class="btn btn-outline-secondary" href="/compliance/profile">Settings</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@if (dashboard is null)
{
    <p>Loading compliance dashboard...</p>
}
else
{
    <section class="summary-grid">
        <AuthorizeView Policy="@KcasPermissions.ClientsView">
            <Authorized>
                <article class="summary-card">
                    <span>Client reviews</span>
                    <strong>Unified client workflow</strong>
                    <a class="btn btn-sm btn-outline-primary mt-3" href="/clients/operational-review">Open reviews</a>
                </article>
            </Authorized>
        </AuthorizeView>
        <article class="summary-card">
            <span>Daily compliance</span>
            <strong>goAML and recurring checks</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/goaml">Open daily work</a>
        </article>
        <article class="summary-card">
            <span>Programme and controls</span>
            <strong>BRA, RMCP and monitoring</strong>
            <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/programme">Open programme</a>
        </article>
        <AuthorizeView Policy="@KcasPermissions.InspectionsView">
            <Authorized>
                <article class="summary-card">
                    <span>Inspection readiness</span>
                    <strong>Cases and evidence packs</strong>
                    <a class="btn btn-sm btn-outline-primary mt-3" href="/compliance/inspections">Open inspections</a>
                </article>
            </Authorized>
        </AuthorizeView>
    </section>

    <section class="work-area">
        @if (goAml is not null)
        {
            <div class="alert @(goAml.IsOverdue ? "alert-danger" : goAml.IsTodayComplete ? "alert-success" : "alert-warning") mb-0">
                <strong>goAML daily check:</strong>
                @if (goAml.IsOverdue)
                {
                    <span>@goAml.MissingDates.Count required check(s) are missing.</span>
                }
                else if (goAml.IsTodayComplete)
                {
                    <span>Today's check is complete.</span>
                }
                else
                {
                    <span>Today's check has not been completed.</span>
                }
                <a class="alert-link ms-2" href="/compliance/goaml">Open goAML register</a>
            </div>
        }
    </section>

    <section class="work-area">
        <div class="investment-summary">
            <div>
                <span>Profile</span>
                <strong>@(dashboard.Profile?.Status ?? "Not captured")</strong>
            </div>
            <div>
                <span>Active methodology</span>
                <strong>@(dashboard.ActiveMethodology?.Name ?? "None")</strong>
            </div>
            <div>
                <span>Pending approvals</span>
                <strong>@dashboard.PendingApprovals</strong>
            </div>
            <div>
                <span>Open tasks</span>
                <strong>@dashboard.OpenTasks</strong>
            </div>
        </div>
    </section>

    <section class="work-area">
        <h2>Upcoming document reviews</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>Review date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in dashboard.UpcomingDocuments)
                    {
                        <tr>
                            <td>
                                <strong>@document.Title</strong>
                                <div class="text-muted small">@document.DocumentType</div>
                            </td>
                            <td>@Display(document.Owner)</td>
                            <td>@document.Status</td>
                            <td>@Date(document.NextReviewDate)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="work-area">
        <h2>Recent audit</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Entity</th>
                        <th>Action</th>
                        <th>User</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audit in dashboard.RecentAudit)
                    {
                        <tr>
                            <td>@audit.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@audit.EntityLabel</td>
                            <td>@audit.Action</td>
                            <td>@Display(audit.UserName)</td>
                            <td>@audit.Reason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private ComplianceDashboardModel? dashboard;
    private GoAmlDashboardModel? goAml;

    protected override async Task OnInitializedAsync()
    {
        var dashboardTask = ComplianceService.LoadDashboardAsync();
        var goAmlTask = GoAml.LoadDashboardAsync();
        await Task.WhenAll(dashboardTask, goAmlTask);
        dashboard = await dashboardTask;
        goAml = await goAmlTask;
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Date(DateOnly? value) => value is null ? "-" : value.Value.ToString("yyyy-MM-dd");
}
