@page "/advice/transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPolicies.AdministratorOnly)]
@using System.ComponentModel.DataAnnotations
@using KCAS.Admin.Data
@inject ClientAdviceTransferService TransferService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Client advice transfers</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Controlled advice transfer</p>
        <h1>Client advice transfers</h1>
        <p class="lede">Move a client's complete KCAS advice history from laptop KCAS to live KCAS.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/advice">Client advice</a>
</div>

<div class="alert alert-info">
    Packages are AES-256 encrypted. Advice records, findings, approvals and audit history are included.
    Referenced files are not duplicated; their paths are remapped to the matching live client folder.
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
}

<section class="detail-grid">
    <article class="detail-panel form-panel">
        <h2>1. Export client advice</h2>
        <label>
            Client
            <select class="form-select" @bind="selectedClientId">
                <option value="0">Select a client</option>
                @foreach (var client in clients)
                {
                    <option value="@client.ClientId">@client.DisplayName @Family(client.KanaanId) - @client.CaseCount case(s), @client.DocumentCount document(s)</option>
                }
            </select>
        </label>
        <label>Export reason <textarea class="form-control" @bind="exportReason"></textarea></label>
        <label>Package passphrase <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphrase" /></label>
        <label>Confirm passphrase <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphraseConfirm" /></label>
        <button class="btn btn-primary" type="button" @onclick="ExportAsync" disabled="@(isBusy || selectedClientId == 0)">Create encrypted package</button>

        @if (exportResult is not null)
        {
            <div class="alert alert-success mt-3">
                <strong>@exportResult.FileName</strong>
                <div>@exportResult.ClientName</div>
                <div>@exportResult.CaseCount advice case(s); @exportResult.DocumentCount document record(s)</div>
                <div>@FormatBytes(exportResult.SizeBytes)</div>
                <a class="btn btn-outline-primary btn-sm mt-2" href="@($"/advice/transfers/{exportResult.PackageId}/download")">Download package</a>
            </div>
        }
    </article>

    <article class="detail-panel form-panel">
        <h2>2. Preview and apply on live</h2>
        <p class="text-muted">Preview validates every client, investment and document-path mapping before any live data changes.</p>
        <label>Encrypted package <InputFile class="form-control" OnChange="SelectImportFileAsync" accept=".kcas-advice" /></label>
        @if (!string.IsNullOrWhiteSpace(importFileName)) { <div class="small text-muted">Selected: @importFileName</div> }
        <label>Package passphrase <input class="form-control" type="password" autocomplete="current-password" @bind="importPassphrase" /></label>
        <button class="btn btn-outline-primary" type="button" @onclick="PreviewAsync" disabled="@(isBusy || importBytes is null)">Preview package</button>

        @if (preview is not null)
        {
            <div class="mt-3">
                <h3>Preview</h3>
                <dl class="detail-list">
                    <dt>Client</dt><dd>@preview.Package.Client.DisplayName @Family(preview.Package.Client.KanaanId)</dd>
                    <dt>Advice cases</dt><dd>@preview.Package.Cases.Count</dd>
                    <dt>Documents</dt><dd>@preview.Package.DocumentCount</dd>
                    <dt>Packaged external files</dt><dd>@preview.Package.EmbeddedFiles.Count</dd>
                    <dt>Audit events</dt><dd>@preview.Package.AuditEvents.Count</dd>
                    <dt>Live client folder</dt><dd><code>@(preview.TargetClientFolder ?? "Not mapped")</code></dd>
                    <dt>Package</dt><dd><code>@preview.Package.PackageId</code></dd>
                </dl>
                @foreach (var warning in preview.Warnings) { <div class="alert alert-warning">@warning</div> }
                @foreach (var conflict in preview.Conflicts) { <div class="alert alert-danger">@conflict</div> }
                @if (preview.CanApply)
                {
                    <label>Live import approval reason <textarea class="form-control" @bind="importReason"></textarea></label>
                    <div class="form-check my-2">
                        <input class="form-check-input" type="checkbox" id="confirm-advice-transfer" @bind="confirmApply" />
                        <label class="form-check-label" for="confirm-advice-transfer">I confirm this package is from the approved laptop KCAS and should update this client's live advice record.</label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="ApplyAsync" disabled="@(isBusy || !confirmApply)">Apply advice package</button>
                }
            </div>
        }
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "clientId")] public int? QueryClientId { get; set; }
    private List<ClientAdviceTransferClientOption> clients = [];
    private int selectedClientId;
    private string exportReason = "Transfer complete client advice record to live KCAS.";
    private string? exportPassphrase; private string? exportPassphraseConfirm;
    private ClientAdviceTransferExportResult? exportResult;
    private byte[]? importBytes; private string? importFileName; private string? importPassphrase;
    private string importReason = "Approved client advice transfer from laptop KCAS.";
    private ClientAdviceTransferPreview? preview; private bool confirmApply; private bool isBusy; private bool isError; private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        clients = await TransferService.LoadClientOptionsAsync();
        if (QueryClientId.HasValue && clients.Any(value => value.ClientId == QueryClientId.Value)) selectedClientId = QueryClientId.Value;
    }

    private async Task ExportAsync()
    {
        if (exportPassphrase != exportPassphraseConfirm) { ShowError("The export passphrases do not match."); return; }
        await RunAsync(async user => { exportResult = await TransferService.ExportAsync(selectedClientId, exportPassphrase ?? "", user, exportReason); statusMessage = "Encrypted advice package created."; });
    }

    private async Task SelectImportFileAsync(InputFileChangeEventArgs args)
    {
        statusMessage = null; preview = null; confirmApply = false; var file = args.File; importFileName = file.Name;
        if (file.Size > 25 * 1024 * 1024) { importBytes = null; ShowError("The package exceeds the 25 MB safety limit."); return; }
        await using var stream = file.OpenReadStream(25 * 1024 * 1024); using var memory = new MemoryStream(); await stream.CopyToAsync(memory); importBytes = memory.ToArray();
    }

    private async Task PreviewAsync() => await RunAsync(async _ => { preview = await TransferService.PreviewAsync(importBytes!, importPassphrase ?? ""); confirmApply = false; statusMessage = preview.CanApply ? "Preview complete. Confirm the package before applying." : "Preview complete with conflicts."; isError = !preview.CanApply; });
    private async Task ApplyAsync() => await RunAsync(async user => { var result = await TransferService.ApplyAsync(importBytes!, importPassphrase ?? "", user, importReason); statusMessage = $"Advice package applied: {result.CaseCount} case(s), {result.DocumentCount} document record(s)."; preview = null; confirmApply = false; });

    private async Task RunAsync(Func<string?, Task> action)
    {
        isBusy = true; isError = false; statusMessage = null;
        try { var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync(); await action(auth.User.Identity?.Name); }
        catch (ValidationException ex) { ShowError(ex.Message); } catch (InvalidOperationException ex) { ShowError(ex.Message); } catch (IOException ex) { ShowError(ex.Message); }
        finally { isBusy = false; }
    }
    private void ShowError(string message) { isError = true; statusMessage = message; }
    private static string Family(string? value) => string.IsNullOrWhiteSpace(value) ? "" : $"({value})";
    private static string FormatBytes(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:N0} KB" : $"{bytes / 1024d / 1024d:N1} MB";
}
