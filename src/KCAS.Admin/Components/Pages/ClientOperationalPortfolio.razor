@page "/clients/operational-review"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ClientsView)]
@using KCAS.Admin.Data
@using KCAS.Admin.Security
@inject ClientOperationalVerificationService VerificationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Client reviews</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Compliance readiness</p>
        <h1>Client reviews</h1>
    </div>
    <div class="header-actions">
        <AuthorizeView Policy="@KcasPolicies.AdministratorOnly">
            <Authorized>
                <a class="btn btn-outline-primary" href="/compliance/review-transfers">Transfer completed reviews</a>
            </Authorized>
        </AuthorizeView>
        <a class="btn btn-outline-secondary" href="/clients">Back to clients</a>
    </div>
</div>

<section class="summary-grid">
    <article class="summary-card"><span>Unreviewed:</span><strong class="ms-1">@Count(ClientLifecycleStatuses.Unreviewed)</strong></article>
    <article class="summary-card"><span>Current:</span><strong class="ms-1">@Count(ClientLifecycleStatuses.Current)</strong></article>
    <article class="summary-card"><span>Other classifications:</span><strong class="ms-1">@(allItems.Count - Count(ClientLifecycleStatuses.Unreviewed) - Count(ClientLifecycleStatuses.Current))</strong></article>
    <article class="summary-card"><span>Pending verification:</span><strong class="ms-1">@allItems.Sum(item => item.PendingVerificationCount)</strong></article>
</section>

<section class="work-area">
    <div class="client-list-toolbar" aria-label="Review filters">
    <div class="client-list-search">
        <label class="form-label" for="reviews-search">Search clients</label>
        <input id="reviews-search" type="search" class="form-control" placeholder="Kanaan ID or client" @bind="searchText" @bind:event="oninput" @bind:after="UpdateFilters" />
    </div>
    <div><label class="form-label" for="lifecycle-filter">Lifecycle</label>
    <select id="lifecycle-filter" class="form-select" @bind="lifecycleFilter" @bind:after="UpdateFilters">
        <option value="">All clients</option>
        @foreach (var status in ClientLifecycleStatuses.All)
        {
            <option value="@status">@status</option>
        }
    </select></div>
    <div><label class="form-label" for="review-filter">Review status</label>
    <select id="review-filter" class="form-select" @bind="reviewFilter" @bind:after="UpdateFilters">
        <option value="">All reviews</option><option value="completed">Completed</option><option value="incomplete">Incomplete</option><option value="duplicate">Resolved duplicate</option>
    </select></div>
    <button class="btn btn-outline-secondary" type="button" @onclick="ResetFilters">Reset filters</button>
    <span class="text-muted" role="status">@(isLoading ? "Loading reviews..." : $"Showing {ShowingStart}-{ShowingEnd} of {filteredItems.Count} clients")</span>
    </div>
</section>
@if (loadError is not null) { <div class="alert alert-danger" role="alert">@loadError <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadPortfolioAsync">Retry</button></div> }
@if (!isLoading && loadError is null && filteredItems.Count == 0) { <section class="empty-state"><h2>No clients found</h2><p>Adjust or reset the filters.</p></section> }

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>
                    <button class="sort-header" type="button" @onclick='() => SortBy("kanaanId")'>
                        Kanaan ID @SortIndicator("kanaanId")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick='() => SortBy("client")'>
                        Client @SortIndicator("client")
                    </button>
                </th>
                <th>Lifecycle</th>
                <th class="text-end">
                    <button class="sort-header" type="button" @onclick='() => SortBy("currentValue")'>
                        Current value @SortIndicator("currentValue")
                    </button>
                </th>
                <th>Review</th>
                <th>Awaiting verification</th>
                <th></th>
            </tr>
            <tr class="filter-row">
                <th>
                    <input class="form-control form-control-sm"
                           @bind="kanaanIdFilter"
                           @bind:event="oninput"
                           @bind:after="UpdateFilters"
                           aria-label="Filter reviews by Kanaan ID" />
                </th>
                <th>
                    <input class="form-control form-control-sm"
                           @bind="clientFilter"
                           @bind:event="oninput"
                           @bind:after="UpdateFilters"
                           aria-label="Filter reviews by client" />
                </th>
                <th colspan="5"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in filteredItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize))
            {
                <tr>
                    <td>@(item.KanaanId ?? "—")</td>
                    <td><a href="@ClientLink(item.ClientId, "")">@item.DisplayName</a></td>
                    <td><span class="@LifecycleBadge(item.LifecycleStatus)">@item.LifecycleStatus</span></td>
                    <td class="text-end">@Money(item.TotalCurrentValueZar)</td>
                    <td>
                        @if (item.HasCompletedAssessment)
                        {
                            <span class="badge text-bg-success">Completed</span>
                        }
                        else if (item.IsReviewResolved)
                        {
                            <span class="badge text-bg-secondary">Resolved as duplicate</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">Incomplete</span>
                        }
                    </td>
                    <td>
                        @item.PendingVerificationCount
                        @if (item.BlockingVerificationCount > 0)
                        {
                            <span class="badge text-bg-warning ms-1">@item.BlockingVerificationCount blocking</span>
                        }
                    </td>
                    <td>
                        <div class="btn-group btn-group-sm" role="group" aria-label="@($"{item.DisplayName} actions")">
                            <a class="btn btn-primary" href="@ClientLink(item.ClientId, "/compliance-review")">@ReviewActionLabel(item)</a>
                            @if (CanTransfer(item))
                            {
                                <AuthorizeView Policy="@KcasPolicies.AdministratorOnly">
                                    <Authorized>
                                        <a class="btn btn-outline-primary" href="@TransferUrl(item)">Transfer</a>
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="notes-pager" aria-label="Review pages">
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(CurrentPage <= 1 || isLoading)" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
    <span>Page @CurrentPage of @PageCount</span>
    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@(CurrentPage >= PageCount || isLoading)" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
</div>

@code {
    private List<ClientOperationalPortfolioItem> allItems = [];
    private List<ClientOperationalPortfolioItem> filteredItems = [];
    [SupplyParameterFromQuery(Name = "q")] public string? searchText { get; set; }
    [SupplyParameterFromQuery(Name = "kanaanId")] public string? kanaanIdFilter { get; set; }
    [SupplyParameterFromQuery(Name = "client")] public string? clientFilter { get; set; }
    [SupplyParameterFromQuery(Name = "lifecycle")] public string? lifecycleFilter { get; set; }
    [SupplyParameterFromQuery(Name = "review")] public string? reviewFilter { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? QuerySort { get; set; }
    [SupplyParameterFromQuery(Name = "direction")] public string? QueryDirection { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? QueryPage { get; set; }
    private const int PageSize = 50;
    private bool isLoading = true;
    private string? loadError;
    private int PageCount => Math.Max(1, (filteredItems.Count + PageSize - 1) / PageSize);
    private int CurrentPage => Math.Clamp(int.TryParse(QueryPage, out var page) ? page : 1, 1, PageCount);
    private int ShowingStart => filteredItems.Count == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int ShowingEnd => Math.Min(CurrentPage * PageSize, filteredItems.Count);
    private string sortColumn = "currentValue";
    private bool sortDescending = true;

    protected override async Task OnInitializedAsync()
        => await LoadPortfolioAsync();

    private async Task LoadPortfolioAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            allItems = await VerificationService.LoadPortfolioAsync(includeExcludedClients: state.User.IsInRole(KcasRoles.Administrator));
            ApplyFilter();
        }
        catch { loadError = "Client reviews could not be loaded. Retry or contact the administrator."; }
        finally { isLoading = false; }
    }

    protected override void OnParametersSet()
    {
        sortColumn = QuerySort is "client" or "kanaanId" or "currentValue" ? QuerySort : "currentValue";
        sortDescending = QueryDirection == "desc" || (QueryDirection != "asc" && sortColumn == "currentValue");
        ApplyFilter();
    }
    private string ClientLink(int id, string suffix) => ClientListNavigation.ClientLink(id, suffix, Navigation.Uri);
    private void ChangePage(int page) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("page", page), replace: true);
    private void ResetFilters() => Navigation.NavigateTo("/clients/operational-review", replace: true);
    private void UpdateFilters() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["q"] = searchText, ["kanaanId"] = kanaanIdFilter, ["client"] = clientFilter, ["lifecycle"] = lifecycleFilter,
        ["review"] = reviewFilter, ["sort"] = sortColumn, ["direction"] = sortDescending ? "desc" : "asc", ["page"] = null
    }), replace: true);

    private void ApplyFilter()
    {
        IEnumerable<ClientOperationalPortfolioItem> items = string.IsNullOrWhiteSpace(lifecycleFilter)
            ? allItems
            : allItems.Where(item => item.LifecycleStatus == lifecycleFilter);
        if (!string.IsNullOrWhiteSpace(searchText))
            items = items.Where(item => item.DisplayName.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) || item.KanaanId?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) == true);
        items = reviewFilter switch
        {
            "completed" => items.Where(item => item.HasCompletedAssessment),
            "incomplete" => items.Where(item => !item.HasCompletedAssessment && !item.IsReviewResolved),
            "duplicate" => items.Where(item => !item.HasCompletedAssessment && item.IsReviewResolved),
            _ => items
        };
        if (!string.IsNullOrWhiteSpace(kanaanIdFilter))
        {
            items = items.Where(item => item.KanaanId?.Contains(kanaanIdFilter.Trim(), StringComparison.OrdinalIgnoreCase) == true);
        }
        if (!string.IsNullOrWhiteSpace(clientFilter))
        {
            items = items.Where(item => item.DisplayName.Contains(clientFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }
        filteredItems = SortItems(items).ToList();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        UpdateFilters();
    }

    private IEnumerable<ClientOperationalPortfolioItem> SortItems(IEnumerable<ClientOperationalPortfolioItem> items)
    {
        if (sortColumn == "currentValue")
        {
            return sortDescending
                ? items.OrderBy(item => !item.TotalCurrentValueZar.HasValue)
                    .ThenByDescending(item => item.TotalCurrentValueZar)
                    .ThenBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
                : items.OrderBy(item => !item.TotalCurrentValueZar.HasValue)
                    .ThenBy(item => item.TotalCurrentValueZar)
                    .ThenBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase);
        }

        var sorted = sortColumn == "kanaanId"
            ? items.OrderBy(item => string.IsNullOrWhiteSpace(item.KanaanId))
                .ThenBy(item => item.KanaanId, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
            : items.OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(item => item.KanaanId, StringComparer.OrdinalIgnoreCase);
        return sortDescending ? sorted.Reverse() : sorted;
    }

    private int Count(string status) => allItems.Count(item => item.LifecycleStatus == status);

    private string SortIndicator(string column) =>
        sortColumn == column ? sortDescending ? "\u2193" : "\u2191" : "";

    private static string Money(decimal? value) =>
        value.HasValue ? $"R {value.Value:N2}" : "—";

    private static bool CanTransfer(ClientOperationalPortfolioItem item) =>
        item.HasCompletedAssessment ||
        (item.LifecycleStatus == ClientLifecycleStatuses.Duplicate && item.HasCanonicalClient);

    private static string TransferUrl(ClientOperationalPortfolioItem item) =>
        item.HasCompletedAssessment
            ? $"/compliance/review-transfers?clientId={item.ClientId}"
            : $"/compliance/duplicate-transfers?clientId={item.ClientId}";

    private static string ReviewActionLabel(ClientOperationalPortfolioItem item) =>
        item.LifecycleStatus == ClientLifecycleStatuses.Duplicate
            ? "View classification"
            : item.HasCompletedAssessment
                ? "View review"
                : item.HasStartedReview
                    ? "Continue review"
                    : "Start review";

    private static string LifecycleBadge(string status) => status switch
    {
        ClientLifecycleStatuses.Current => "badge text-bg-success",
        ClientLifecycleStatuses.Unreviewed => "badge text-bg-warning",
        _ => "badge text-bg-secondary"
    };
}
