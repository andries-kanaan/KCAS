@page "/compliance/client-evidence"
@page "/compliance/client-evidence/scan"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@using KCAS.Admin.Security
@inject ClientEvidenceReadinessService EvidenceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DocumentPathDisplayService PathDisplay

<PageTitle>Client evidence readiness</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Compliance administration</p>
        <h1>Client evidence readiness</h1>
        <p class="lede">Track linked evidence and readiness for client risk assessment.</p>
    </div>
    <a class="btn btn-outline-secondary" href="/compliance">Compliance dashboard</a>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-info">@statusMessage</div>
}

@if (model is null)
{
    <p>Loading client evidence readiness...</p>
}
else
{
    <section class="summary-grid">
        <article class="summary-card">
            <span>Requirements</span>
            <strong>@model.RequirementCount</strong>
        </article>
        <article class="summary-card">
            <span>Ready clients</span>
            <strong>@model.ReadyClientCount</strong>
        </article>
        <article class="summary-card">
            <span>Blocked clients</span>
            <strong>@model.BlockedClientCount</strong>
        </article>
    </section>

    <section class="work-area">
        <h2>Client folder root</h2>
        <p class="text-muted">Set the server path used to find client folders. Changing this path does not scan folders or change linked evidence.</p>
        <div class="workspace-grid">
            <input class="form-control" @bind="scanRootPath" placeholder="Server client document root path" disabled="@(!canManage)" />
            <input class="form-control" @bind="reason" placeholder="Reason for other changes (automatic when saving root)" disabled="@(!canManage)" />
        </div>
        <div class="row-actions mt-2">
            <button type="button" class="btn btn-outline-secondary" @onclick="OpenFolderPicker" disabled="@(!canManage)">Browse folders</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="SaveRootAsync" disabled="@(!canManage)">Save root</button>
        </div>
        <ServerFolderPicker IsOpen="@isFolderPickerOpen"
                            InitialPath="@scanRootPath"
                            Disabled="@(!canManage)"
                            Title="Choose client folder root"
                            Selected="SelectFolder"
                            Closed="CloseFolderPicker" />
    </section>

    <section class="work-area">
        <h2>Client readiness</h2>
        <div class="notes-toolbar">
            <div class="note-count">Showing @ClientShowingStart(FilteredClients.Count)-@ClientShowingEnd(FilteredClients.Count) of @FilteredClients.Count</div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle filter-table">
                <thead>
                    <tr>
                        <th>
                            <button type="button" class="sort-header" @onclick='() => SetClientSort("client")'>Client @SortGlyph("client")</button>
                        </th>
                        <th>
                            <button type="button" class="sort-header" @onclick='() => SetClientSort("surname")'>Surname @SortGlyph("surname")</button>
                        </th>
                        <th>Category</th>
                        <th>Lifecycle</th>
                        <th>Client folder</th>
                        <th>Linked</th>
                        <th>Verified</th>
                        <th>Complete</th>
                        <th>Exceptions</th>
                        <th>Blocked</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                    <tr class="filter-row">
                        <th><input class="form-control form-control-sm" @bind="clientSearch" @bind:event="oninput" placeholder="Search client" /></th>
                        <th><input class="form-control form-control-sm" @bind="surnameSearch" @bind:event="oninput" placeholder="Search surname" /></th>
                        <th></th>
                        <th>
                            <select class="form-select form-select-sm" @bind="lifecycleFilter">
                                <option value="">All lifecycle</option>
                                @foreach (var status in ClientLifecycleStatuses.All.OrderBy(value => value))
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </th>
                        <th colspan="6"></th>
                        <th>
                            <select class="form-select form-select-sm" @bind="readinessFilter">
                                <option value="">All readiness</option>
                                <option value="@ReadinessReady">Ready</option>
                                <option value="@ReadinessNotReady">Not ready</option>
                            </select>
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in PagedClients)
                    {
                        <tr>
                            <td>@client.DisplayName</td>
                            <td>@Display(client.SurnameOrEntityName)</td>
                            <td>@client.ClientCategory</td>
                            <td>@client.LifecycleStatus</td>
                            <td>
                                @if (canManage)
                                {
                                    <div class="client-folder-scan-row">
                                        <input class="form-control form-control-sm" @bind="clientFolderPaths[client.ClientId]" placeholder="Select client folder" />
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenClientFolderPicker(client.ClientId)">Browse</button>
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => SaveClientFolderAsync(client.ClientId)">Save</button>
                                    </div>
                                }
                                else
                                {
                                    @Display(PathDisplay.ForWorkstation(client.ClientFolder))
                                }
                            </td>
                            <td>@client.LinkedEvidenceCount</td>
                            <td>@client.VerifiedEvidenceCount</td>
                            <td>@(client.CompleteCount + client.ExceptionCount) / @client.RequiredCount</td>
                            <td>@client.ExceptionCount</td>
                            <td>@client.BlockedCount</td>
                            <td>@(client.IsReadyForRiskAssessment ? "Ready" : "Blocked")</td>
                            <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="@($"/clients/{client.ClientId}/evidence")">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (ClientPageCount(FilteredClients.Count) > 1)
        {
            <div class="notes-pager" aria-label="Client readiness pages">
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="PreviousClientPage" disabled="@(clientPage <= 1)">Previous</button>
                <span>Page @clientPage of @ClientPageCount(FilteredClients.Count)</span>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="@(() => NextClientPage(FilteredClients.Count))" disabled="@(clientPage >= ClientPageCount(FilteredClients.Count))">Next</button>
            </div>
        }
        <ServerFolderPicker IsOpen="@(clientFolderPickerClientId is not null)"
                            InitialPath="@ClientFolderPickerInitialPath"
                            Disabled="@(!canManage)"
                            Title="Choose client folder"
                            Selected="SelectClientFolder"
                            Closed="CloseClientFolderPicker" />
    </section>

}

@code {
    private const string RootUpdateReason = "Configure live client evidence root.";
    private const string ReadinessReady = "Ready";
    private const string ReadinessNotReady = "NotReady";
    private const int ClientPageSize = 50;

    private ClientEvidenceDashboardModel? model;
    private string? scanRootPath;
    private string? reason;
    private string? currentUser;
    private bool canManage;
    private bool isAdministrator;
    private string? statusMessage;
    private string? clientSearch;
    private string? surnameSearch;
    private string? lifecycleFilter;
    private string? readinessFilter;
    private string clientSortColumn = "client";
    private bool isClientSortDescending;
    private int clientPage = 1;
    private bool isFolderPickerOpen;
    private int? clientFolderPickerClientId;
    private readonly Dictionary<int, string?> clientFolderPaths = [];

    private string? ClientFolderPickerInitialPath => clientFolderPickerClientId is int clientId && clientFolderPaths.TryGetValue(clientId, out var path)
        ? path
        : null;

    private List<ClientEvidenceClientSummaryModel> FilteredClients
    {
        get
        {
            if (model is null)
            {
                return [];
            }

            var clients = model.Clients.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(clientSearch))
            {
                clients = clients.Where(client => ContainsSearch(client.DisplayName, clientSearch));
            }

            if (!string.IsNullOrWhiteSpace(surnameSearch))
            {
                clients = clients.Where(client => ContainsSearch(client.SurnameOrEntityName, surnameSearch));
            }

            if (!string.IsNullOrWhiteSpace(lifecycleFilter))
            {
                clients = clients.Where(client => string.Equals(client.LifecycleStatus, lifecycleFilter, StringComparison.Ordinal));
            }

            if (readinessFilter == ReadinessReady)
            {
                clients = clients.Where(client => client.IsReadyForRiskAssessment);
            }
            else if (readinessFilter == ReadinessNotReady)
            {
                clients = clients.Where(client => !client.IsReadyForRiskAssessment);
            }

            clients = clientSortColumn == "surname"
                ? clients.OrderBy(client => client.SurnameOrEntityName, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(client => client.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                : clients.OrderBy(client => client.DisplayName, StringComparer.CurrentCultureIgnoreCase)
                    .ThenBy(client => client.SurnameOrEntityName, StringComparer.CurrentCultureIgnoreCase);

            return (isClientSortDescending ? clients.Reverse() : clients).ToList();
        }
    }

    private List<ClientEvidenceClientSummaryModel> PagedClients
    {
        get
        {
            var clients = FilteredClients;
            var pageCount = ClientPageCount(clients.Count);
            if (clientPage > pageCount)
            {
                clientPage = pageCount;
            }

            return clients
                .Skip((clientPage - 1) * ClientPageSize)
                .Take(ClientPageSize)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = authState.User.Identity?.Name;
        canManage = authState.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceManage);
        isAdministrator = authState.User.IsInRole(KcasRoles.Administrator);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        model = await EvidenceService.LoadDashboardAsync(isAdministrator);
        scanRootPath = model.ScanRootPath ?? scanRootPath;
        foreach (var client in model.Clients)
        {
            clientFolderPaths.TryAdd(client.ClientId, client.ClientFolder);
        }
    }

    private async Task SaveRootAsync() => await ExecuteAsync(async () => await EvidenceService.SaveScanRootAsync(
        scanRootPath ?? "",
        currentUser,
        string.IsNullOrWhiteSpace(reason) ? RootUpdateReason : reason));

    private void SelectFolder(string path) => scanRootPath = path;

    private void OpenFolderPicker() => isFolderPickerOpen = true;

    private void OpenClientFolderPicker(int clientId) => clientFolderPickerClientId = clientId;

    private void CloseFolderPicker() => isFolderPickerOpen = false;

    private async Task SelectClientFolder(string path)
    {
        if (clientFolderPickerClientId is int clientId)
        {
            clientFolderPaths[clientId] = path;
            try
            {
                await EvidenceService.SaveClientEvidenceFolderAsync(clientId, path, currentUser, FolderSelectionReason);
                statusMessage = "Client folder saved.";
                await LoadAsync();
            }
            catch (Exception ex)
            {
                statusMessage = ex.Message;
            }
        }
    }

    private void CloseClientFolderPicker() => clientFolderPickerClientId = null;

    private async Task SaveClientFolderAsync(int clientId)
    {
        if (!clientFolderPaths.TryGetValue(clientId, out var clientFolder) || string.IsNullOrWhiteSpace(clientFolder))
        {
            statusMessage = "Select a client folder before saving it.";
            return;
        }

        try
        {
            await EvidenceService.SaveClientEvidenceFolderAsync(clientId, clientFolder, currentUser, FolderSelectionReason);
            statusMessage = "Client folder saved. Linked evidence was not changed.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        try
        {
            await action();
            statusMessage = "Client evidence readiness updated.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private void SetClientSort(string column)
    {
        if (clientSortColumn == column)
        {
            isClientSortDescending = !isClientSortDescending;
            return;
        }

        clientSortColumn = column;
        isClientSortDescending = false;
    }

    private void PreviousClientPage()
    {
        if (clientPage > 1)
        {
            clientPage--;
        }
    }

    private void NextClientPage(int clientCount)
    {
        if (clientPage < ClientPageCount(clientCount))
        {
            clientPage++;
        }
    }

    private static int ClientPageCount(int clientCount) =>
        Math.Max(1, (int)Math.Ceiling(clientCount / (double)ClientPageSize));

    private int ClientShowingStart(int clientCount) =>
        clientCount == 0 ? 0 : ((Math.Min(clientPage, ClientPageCount(clientCount)) - 1) * ClientPageSize) + 1;

    private int ClientShowingEnd(int clientCount) =>
        Math.Min(clientCount, Math.Min(clientPage, ClientPageCount(clientCount)) * ClientPageSize);

    private string SortGlyph(string column) => clientSortColumn == column
        ? isClientSortDescending ? "Down" : "Up"
        : "";

    private string FolderSelectionReason => string.IsNullOrWhiteSpace(reason)
        ? "Select client evidence folder."
        : reason;

    private static bool ContainsSearch(string? value, string? search) =>
        !string.IsNullOrWhiteSpace(value) &&
        !string.IsNullOrWhiteSpace(search) &&
        value.Contains(search, StringComparison.CurrentCultureIgnoreCase);

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

}
