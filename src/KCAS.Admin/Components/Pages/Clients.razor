@page "/clients"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ClientsView)]
@using KCAS.Admin.Data
@using KCAS.Admin.Security
@inject ClientSearchService ClientSearch
@inject ClientVisibilityService ClientVisibility
@inject ComplianceWorkService WorkService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Clients</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Client register</p>
        <h1>Clients</h1>
    </div>
    <AuthorizeView Policy="@KcasPermissions.ClientsManage">
        <Authorized>
            <a class="btn btn-primary" href="/clients/new">New client</a>
        </Authorized>
    </AuthorizeView>
</div>

@if (isAdministrator)
{
    <section class="work-area mb-3">
        <h2>Client visibility</h2>
        <div class="d-flex flex-wrap align-items-end gap-2">
            <div>
                <label class="form-label" for="visibility-action">Bulk action</label>
                <select id="visibility-action" class="form-select" @bind="visibilityAction" @bind:after="ClearVisibilityPreview" disabled="@visibilityBusy">
                    <option value="@ClientVisibilityActions.HideZeroBalance">Hide zero-balance clients</option>
                    <option value="@ClientVisibilityActions.UnhideZeroBalance">Unhide zero-balance clients</option>
                    <option value="@ClientVisibilityActions.UnhideAll">Unhide all clients</option>
                </select>
            </div>
            <button type="button" class="btn btn-outline-secondary" @onclick="PreviewVisibilityAsync" disabled="@visibilityBusy">Preview</button>
        </div>
        @if (visibilityPreviewCount.HasValue)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <p>@visibilityPreviewCount client(s) will be changed. Only clients with a known R0.00 current value qualify for zero-balance actions; missing valuations are excluded.</p>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-primary" @onclick="ApplyVisibilityAsync" disabled="@(visibilityBusy || visibilityPreviewCount == 0)">Confirm</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClearVisibilityPreview" disabled="@visibilityBusy">Cancel</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(visibilityMessage))
        {
            <div class="alert @(visibilityError ? "alert-danger" : "alert-success") mt-3 mb-0">@visibilityMessage</div>
        }
    </section>
}

@if (annualNotificationsCreated > 0)
{
    <div class="alert alert-success">
        @annualNotificationsCreated annual compliance-review notification(s) created for Compliance Administrators and Compliance Approvers.
    </div>
}

@if (reviewNotifications.Count > 0)
{
    <section class="work-area">
        <h2>Client compliance reviews due</h2>
        <div class="list-group">
            @foreach (var item in reviewNotifications)
            {
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>@item.Title</strong>
                        <div class="text-muted small">Due: @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                    </div>
                    @if (item.ClientId.HasValue)
                    {
                        <a class="btn btn-sm btn-primary" href="@($"/clients/{item.ClientId}/evidence")">Review client</a>
                    }
                </div>
            }
        </div>
        <a class="btn btn-outline-secondary mt-3" href="/compliance/work-register">Open compliance worklist</a>
    </section>
}

@if (clients.Count == 0)
{
    <section class="empty-state">
        <h2>No clients found</h2>
        <p>Adjust the column filters or create a new client.</p>
    </section>
}

<div class="table-responsive">
    <table class="table align-middle filter-table clients-table">
        <colgroup>
            <col class="clients-column-id" />
            <col class="clients-column-name" />
            <col class="clients-column-surname" />
            <col class="clients-column-email" />
            <col class="clients-column-phone" />
            <col class="clients-column-status" />
            <col class="clients-column-investment" />
            <col class="clients-column-value" />
        </colgroup>
        <thead>
            <tr>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("kanaanId"))">
                        Kanaan ID @SortIndicator("kanaanId")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("name"))">
                        Name @SortIndicator("name")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("surname"))">
                        Surname @SortIndicator("surname")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("email"))">
                        Primary email @SortIndicator("email")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("phone"))">
                        Primary phone @SortIndicator("phone")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("status"))">
                        Status @SortIndicator("status")
                    </button>
                </th>
                <th>
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("investment"))">
                        Investment position @SortIndicator("investment")
                    </button>
                </th>
                <th class="text-end">
                    <button class="sort-header" type="button" @onclick="@(() => SortByAsync("currentValue"))">
                        Current value @SortIndicator("currentValue")
                    </button>
                </th>
            </tr>
            <tr class="filter-row">
                <th>
                    <input class="form-control form-control-sm" @bind="kanaanIdFilter" @bind:event="oninput" @bind:after="LoadClientsAsync" aria-label="Filter by Kanaan ID" />
                </th>
                <th>
                    <input class="form-control form-control-sm" @bind="nameFilter" @bind:event="oninput" @bind:after="LoadClientsAsync" aria-label="Filter by name" />
                </th>
                <th>
                    <input class="form-control form-control-sm" @bind="surnameFilter" @bind:event="oninput" @bind:after="LoadClientsAsync" aria-label="Filter by surname" />
                </th>
                <th>
                    <input class="form-control form-control-sm" @bind="emailFilter" @bind:event="oninput" @bind:after="LoadClientsAsync" aria-label="Filter by email" />
                </th>
                <th>
                    <input class="form-control form-control-sm" @bind="phoneFilter" @bind:event="oninput" @bind:after="LoadClientsAsync" aria-label="Filter by phone" />
                </th>
                <th>
                    <select class="form-select form-select-sm" @bind="statusFilter" @bind:after="LoadClientsAsync" aria-label="Filter by lifecycle status">
                        <option value="">All lifecycle statuses</option>
                        @foreach (var status in ClientLifecycleStatuses.All)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </th>
                <th>
                    <select class="form-select form-select-sm" @bind="investmentPositionFilter" @bind:after="LoadClientsAsync" aria-label="Filter by investment position">
                        <option value="">All investment positions</option>
                        <option value="@ClientInvestmentPositionFilters.Current">Current investments</option>
                        <option value="@ClientInvestmentPositionFilters.NoCurrent">No current investments</option>
                        <option value="@ClientInvestmentPositionFilters.HistoricalOnly">Historical investments only</option>
                        <option value="@ClientInvestmentPositionFilters.NeedsCorrection">Needs status correction</option>
                    </select>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.KanaanId</td>
                    <td>
                        <a href="@($"/clients/{client.Id}")">@client.Name</a>
                    </td>
                    <td>@client.Surname</td>
                    <td>@client.PrimaryEmail</td>
                    <td>@client.PrimaryPhone</td>
                    <td><span class="@LifecycleBadge(client.LifecycleStatus)">@client.LifecycleStatus</span></td>
                    <td>
                        <span>@client.InvestmentPosition</span>
                        @if (client.LifecycleStatus == ClientLifecycleStatuses.Unreviewed &&
                             !client.HasCurrentInvestments)
                        {
                            <div><span class="badge text-bg-warning">Lifecycle review required</span></div>
                        }
                    </td>
                    <td class="text-end">@Money(client.TotalCurrentValueZar)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private string? kanaanIdFilter;
    private string? nameFilter;
    private string? surnameFilter;
    private string? emailFilter;
    private string? phoneFilter;
    private string? statusFilter;
    private string? investmentPositionFilter;
    private string sortColumn = "currentValue";
    private bool sortDescending = true;
    private List<ClientSearchResult> clients = [];
    private IReadOnlyList<ComplianceWorkListItem> reviewNotifications = [];
    private int annualNotificationsCreated;
    private bool isAdministrator;
    private string visibilityAction = ClientVisibilityActions.HideZeroBalance;
    private int? visibilityPreviewCount;
    private bool visibilityBusy;
    private bool visibilityError;
    private string? visibilityMessage;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAdministrator = state.User.IsInRole(KcasRoles.Administrator);
        await LoadClientsAsync();
        var userName = state.User.Identity?.Name;
        if ((state.User.IsInRole(KcasRoles.ComplianceAdministrator) ||
             state.User.IsInRole(KcasRoles.ComplianceApprover)) &&
            !string.IsNullOrWhiteSpace(userName))
        {
            annualNotificationsCreated = await WorkService.EnsureAnnualClientReviewTasksAsync(
                DateOnly.FromDateTime(DateTime.Today), userName);
            reviewNotifications = await WorkService.LoadDueReviewNotificationsAsync(
                isAdministrator);
        }
    }

    private async Task SortByAsync(string column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = false;
        }

        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        clients = await ClientSearch.SearchAsync(new ClientSearchRequest(
            KanaanId: kanaanIdFilter,
            Name: nameFilter,
            Surname: surnameFilter,
            Email: emailFilter,
            Phone: phoneFilter,
            Status: statusFilter,
            InvestmentPosition: investmentPositionFilter,
            SortColumn: sortColumn,
            SortDescending: sortDescending),
            includeExcludedClients: isAdministrator);
    }

    private void ClearVisibilityPreview()
    {
        visibilityPreviewCount = null;
        visibilityMessage = null;
    }

    private async Task PreviewVisibilityAsync()
    {
        if (!await IsAdministratorAsync()) return;
        visibilityBusy = true;
        visibilityPreviewCount = null;
        visibilityMessage = null;
        try
        {
            visibilityPreviewCount = await ClientVisibility.PreviewAsync(visibilityAction);
        }
        catch (Exception ex)
        {
            visibilityError = true;
            visibilityMessage = ex.Message;
        }
        finally
        {
            visibilityBusy = false;
        }
    }

    private async Task ApplyVisibilityAsync()
    {
        if (!await IsAdministratorAsync() || !visibilityPreviewCount.HasValue) return;
        visibilityBusy = true;
        visibilityMessage = null;
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var changed = await ClientVisibility.ApplyAsync(
                visibilityAction, visibilityPreviewCount.Value, state.User.Identity?.Name);
            visibilityError = false;
            visibilityMessage = $"Updated visibility for {changed} client(s).";
            visibilityPreviewCount = null;
            await LoadClientsAsync();
        }
        catch (Exception ex)
        {
            visibilityError = true;
            visibilityMessage = ex.Message;
            visibilityPreviewCount = null;
        }
        finally
        {
            visibilityBusy = false;
        }
    }

    private async Task<bool> IsAdministratorAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.IsInRole(KcasRoles.Administrator);
    }

    private string SortIndicator(string column)
    {
        if (sortColumn != column)
        {
            return string.Empty;
        }

        return sortDescending ? "down" : "up";
    }

    private static string LifecycleBadge(string status) => status switch
    {
        ClientLifecycleStatuses.Current => "badge text-bg-success",
        ClientLifecycleStatuses.Unreviewed => "badge text-bg-warning",
        ClientLifecycleStatuses.Closed or ClientLifecycleStatuses.Historical => "badge text-bg-secondary",
        ClientLifecycleStatuses.Deceased => "badge text-bg-dark",
        ClientLifecycleStatuses.Duplicate => "badge text-bg-info",
        _ => "badge text-bg-light"
    };

    private static string Money(decimal? value) =>
        value.HasValue ? $"R {value.Value:N2}" : "—";
}
