@page "/compliance/business-risk/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceView)]
@using KCAS.Admin.Data
@inject BusinessRiskAssessmentService BusinessRiskService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Business Risk Assessment</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Business Risk Assessment</p>
        <h1>@(assessment?.Name ?? "Loading...")</h1>
        @if (assessment is not null)
        {
            <p class="text-muted mb-0">As at @assessment.AsAtDate.ToString("yyyy-MM-dd") · @assessment.Status · @assessment.Approvals.Count of 2 KI approvals</p>
        }
    </div>
    <div class="header-actions"><a class="btn btn-outline-secondary" href="/compliance/business-risk">All versions</a></div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info">@message</div>
}

@if (assessment is null || editModel is null)
{
    <p>Loading assessment...</p>
}
else
{
    <section class="work-area">
        <h2>Controlled action reason</h2>
        <input class="form-control" @bind="reason" placeholder="Required for save, submit, approval and activation" />
    </section>

    <section class="work-area">
        <h2>Assessment context</h2>
        <div class="workspace-grid">
            <input class="form-control" @bind="editModel.Name" disabled="@(!CanEdit)" />
            <InputNumber class="form-control" @bind-Value="editModel.AssessmentYear" disabled="@(!CanEdit)" />
            <InputDate class="form-control" @bind-Value="editModel.AsAtDate" disabled="@(!CanEdit)" />
        </div>
        <label class="form-label mt-3">Scope</label>
        <textarea class="form-control" rows="2" @bind="editModel.Scope" disabled="@(!CanEdit)"></textarea>
        <label class="form-label mt-3">Methodology</label>
        <textarea class="form-control" rows="3" @bind="editModel.MethodologyNarrative" disabled="@(!CanEdit)"></textarea>
        <label class="form-label mt-3">Management judgement</label>
        <textarea class="form-control" rows="3" @bind="editModel.ManagementJudgement" disabled="@(!CanEdit)"></textarea>
        <label class="form-label mt-3">Known limitations</label>
        <textarea class="form-control" rows="2" @bind="editModel.Limitations" disabled="@(!CanEdit)"></textarea>
        <label class="form-label mt-3">Risk tolerance</label>
        <textarea class="form-control" rows="2" @bind="editModel.RiskTolerance" disabled="@(!CanEdit)"></textarea>
    </section>

    @foreach (var item in editModel.Items)
    {
        var score = item.Likelihood * item.Impact;
        <section class="work-area">
            <h2>@BusinessRiskCategories.Display(item.Category)</h2>
            <label class="form-label">Risk statement</label>
            <textarea class="form-control" rows="2" @bind="item.RiskStatement" disabled="@(!CanEdit)"></textarea>
            <label class="form-label mt-3">Operational evidence and rationale</label>
            <textarea class="form-control" rows="3" @bind="item.EvidenceAndRationale" disabled="@(!CanEdit)"></textarea>
            <div class="workspace-grid mt-3">
                <label>Likelihood (1–3)<InputNumber class="form-control" min="1" max="3" @bind-Value="item.Likelihood" disabled="@(!CanEdit)" /></label>
                <label>Impact (1–3)<InputNumber class="form-control" min="1" max="3" @bind-Value="item.Impact" disabled="@(!CanEdit)" /></label>
                <label>Inherent result<input class="form-control" value="@($"{score} · {SafeRating(score)}")" disabled /></label>
                <label>Control effectiveness
                    <select class="form-select" @bind="item.ControlEffectiveness" disabled="@(!CanEdit)">
                        @foreach (var option in BusinessRiskControlEffectiveness.All) { <option value="@option">@DisplayOption(option)</option> }
                    </select>
                </label>
            </div>
            <label class="form-label mt-3">Key controls</label>
            <textarea class="form-control" rows="3" @bind="item.KeyControls" disabled="@(!CanEdit)"></textarea>
            <div class="workspace-grid mt-3">
                <label>Residual rating
                    <select class="form-select" @bind="item.ResidualRating" disabled="@(!CanEdit)">
                        @foreach (var option in BusinessRiskRatings.All) { <option value="@option">@option</option> }
                    </select>
                </label>
                <label>Treatment
                    <select class="form-select" @bind="item.TreatmentDecision" disabled="@(!CanEdit)">
                        @foreach (var option in BusinessRiskTreatmentDecisions.All) { <option value="@option">@option</option> }
                    </select>
                </label>
                <label>Owner<input class="form-control" @bind="item.Owner" disabled="@(!CanEdit)" /></label>
                <label>Due date<InputDate class="form-control" @bind-Value="item.DueDate" disabled="@(!CanEdit)" /></label>
            </div>
            <label class="form-label mt-3">Residual-risk rationale</label>
            <textarea class="form-control" rows="2" @bind="item.ResidualRationale" disabled="@(!CanEdit)"></textarea>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(assessment.PortfolioSnapshotJson))
    {
        <section class="work-area">
            <h2>Frozen portfolio evidence</h2>
            <p class="text-muted">Generated from approved client assessments and current investment records as at the stated date. It is evidence, not an automatic BRA conclusion.</p>
            <pre class="border rounded p-3 bg-light">@assessment.PortfolioSnapshotJson</pre>
        </section>
    }

    <section class="work-area">
        <h2>Approval history</h2>
        @if (assessment.Approvals.Count == 0) { <p>No KI approvals recorded.</p> }
        else
        {
            <ul>
                @foreach (var approval in assessment.Approvals)
                {
                    <li>@approval.Approver — @approval.ApprovedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @approval.Reason</li>
                }
            </ul>
        }
        <div class="d-flex flex-wrap gap-2">
            @if (CanEdit)
            {
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save draft</button>
                <button type="button" class="btn btn-outline-primary" @onclick="SubmitAsync">Submit for KI approval</button>
            }
            @if (canApprove && assessment.Status == ComplianceStatuses.Review)
            {
                <button type="button" class="btn btn-success" @onclick="ApproveAsync">Record my KI approval</button>
            }
            @if (canApprove && assessment.Status == ComplianceStatuses.Approved)
            {
                <button type="button" class="btn btn-success" @onclick="ActivateAsync">Make effective</button>
            }
            @if (assessment.Status is ComplianceStatuses.Approved or ComplianceStatuses.Active or ComplianceStatuses.Superseded)
            {
                <a class="btn btn-outline-secondary" href="@($"/compliance/business-risk/{Id}/print")">View approved record</a>
            }
        </div>
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    private BusinessRiskAssessment? assessment;
    private BusinessRiskAssessmentEditModel? editModel;
    private string reason = "";
    private string? currentUser;
    private string? message;
    private bool canManage;
    private bool canApprove;
    private bool CanEdit => canManage && assessment?.Status == ComplianceStatuses.Draft;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUser = state.User.Identity?.Name;
        canManage = state.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceManage);
        canApprove = state.User.HasClaim(KcasClaimTypes.Permission, KcasPermissions.ComplianceApprove);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        assessment = await BusinessRiskService.LoadAsync(Id);
        editModel = assessment is null ? null : BusinessRiskAssessmentEditModel.FromEntity(assessment);
    }

    private async Task SaveAsync() => await ExecuteAsync(() => BusinessRiskService.SaveDraftAsync(editModel!, currentUser, reason), "Draft saved.");
    private async Task SubmitAsync()
    {
        await ExecuteAsync(async () =>
        {
            await BusinessRiskService.SaveDraftAsync(editModel!, currentUser, reason);
            await BusinessRiskService.SubmitAsync(Id, currentUser, reason);
        }, "Submitted for two distinct KI approvals.");
    }
    private async Task ApproveAsync() => await ExecuteAsync(() => BusinessRiskService.ApproveAsync(Id, currentUser, reason), "KI approval recorded.");
    private async Task ActivateAsync() => await ExecuteAsync(() => BusinessRiskService.ActivateAsync(Id, currentUser, reason), "BRA is now effective.");

    private async Task ExecuteAsync(Func<Task> action, string success)
    {
        try
        {
            await action();
            message = success;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    private static string SafeRating(int score) => score is >= 1 and <= 9 ? BusinessRiskAssessmentService.RatingFor(score) : "Invalid";
    private static string DisplayOption(string value) => value switch
    {
        BusinessRiskControlEffectiveness.PartiallyEffective => "Partially effective",
        _ => value
    };
}
