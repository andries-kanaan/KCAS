@page "/compliance/review-transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceManage)]
@using System.ComponentModel.DataAnnotations
@using KCAS.Admin.Data
@inject ClientReviewTransferService TransferService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Client review transfers</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Controlled operational transfer</p>
        <h1>Client review transfers</h1>
        <p class="lede">Move an approved local client review to live KCAS without database replacement or manual recapture.</p>
    </div>
</div>

<div class="alert alert-info">
    Packages are AES-256 encrypted and contain evidence metadata and hashes, not document contents.
    The passphrase is never stored. Current package storage: <code>@TransferService.StorageRoot</code>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
}

<section class="detail-grid">
    <article class="detail-panel form-panel">
        <h2>1. Export completed review</h2>
        <p class="text-muted">Only a finalised or approved client assessment can be exported.</p>
        <label>
            Client
            <select class="form-select" @bind="exportClientId">
                <option value="0">Select a completed client</option>
                @foreach (var client in clients)
                {
                    <option value="@client.Id">@client.DisplayName (@Display(client.KanaanId))</option>
                }
            </select>
        </label>
        <label>Export reason <textarea class="form-control" @bind="exportReason"></textarea></label>
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphrase" />
        </label>
        <label>
            Confirm passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphraseConfirm" />
        </label>
        <button class="btn btn-primary" type="button" @onclick="ExportAsync" disabled="@isBusy">
            Create encrypted package
        </button>

        @if (exportResult is not null)
        {
            <div class="alert alert-success mt-3">
                <strong>@exportResult.FileName</strong>
                <div>@exportResult.SizeBytes.ToString("N0") bytes</div>
                <div class="small text-muted">@exportResult.StoragePath</div>
                <a class="btn btn-outline-primary btn-sm mt-2"
                   href="@($"/compliance/review-transfers/{exportResult.PackageId}/download")">
                    Download package
                </a>
            </div>
        }
    </article>

    <article class="detail-panel form-panel">
        <h2>2. Preview and apply on live</h2>
        <p class="text-muted">Preview never changes data. Apply is blocked if client, methodology or assessment data conflicts.</p>
        <label>
            Encrypted package
            <InputFile class="form-control" OnChange="SelectImportFileAsync" accept=".kcas-review" />
        </label>
        @if (!string.IsNullOrWhiteSpace(importFileName))
        {
            <div class="text-muted small">Selected: @importFileName</div>
        }
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="current-password" @bind="importPassphrase" />
        </label>
        <button class="btn btn-outline-primary" type="button" @onclick="PreviewAsync"
                disabled="@(isBusy || importBytes is null)">
            Preview package
        </button>

        @if (preview is not null)
        {
            <div class="mt-3">
                <h3>Preview</h3>
                <dl class="detail-list">
                    <dt>Client</dt><dd>@preview.Package.Client.DisplayName (@Display(preview.Package.Client.KanaanId))</dd>
                    <dt>Live match</dt><dd>@Display(preview.TargetClientName)</dd>
                    <dt>Assessment</dt><dd>@preview.Package.Assessment.FinalRating — @preview.Package.Assessment.Status</dd>
                    <dt>Methodology</dt><dd>@preview.Package.Assessment.MethodologyName @preview.Package.Assessment.MethodologyVersionLabel</dd>
                    <dt>Evidence</dt><dd>@preview.NewEvidenceCount new; @preview.ExistingEvidenceCount already present</dd>
                    <dt>Package</dt><dd><code>@preview.Package.PackageId</code></dd>
                </dl>
                @foreach (var warning in preview.Warnings)
                {
                    <div class="alert alert-warning">@warning</div>
                }
                @foreach (var conflict in preview.Conflicts)
                {
                    <div class="alert alert-danger">@conflict</div>
                }

                @if (preview.CanApply)
                {
                    <label>
                        Live import approval reason
                        <textarea class="form-control" @bind="importReason"></textarea>
                    </label>
                    <div class="form-check my-2">
                        <input class="form-check-input" type="checkbox" id="confirm-transfer" @bind="confirmApply" />
                        <label class="form-check-label" for="confirm-transfer">
                            I confirm this preview belongs to the correct live client.
                        </label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="ApplyAsync"
                            disabled="@(isBusy || !confirmApply)">
                        Apply reviewed package
                    </button>
                }
            </div>
        }
    </article>
</section>

@code {
    private List<InvestmentSummaryClientOption> clients = [];
    private int exportClientId;
    private string? exportReason;
    private string? exportPassphrase;
    private string? exportPassphraseConfirm;
    private ClientReviewExportResult? exportResult;
    private byte[]? importBytes;
    private string? importFileName;
    private string? importPassphrase;
    private string? importReason;
    private ClientReviewTransferPreview? preview;
    private bool confirmApply;
    private bool isBusy;
    private bool isError;
    private string? statusMessage;

    protected override async Task OnInitializedAsync() =>
        clients = await TransferService.LoadClientOptionsAsync();

    private async Task ExportAsync()
    {
        if (exportPassphrase != exportPassphraseConfirm)
        {
            ShowError("The export passphrases do not match.");
            return;
        }
        await RunAsync(async user =>
        {
            exportResult = await TransferService.ExportAsync(
                exportClientId, exportPassphrase ?? "", user, exportReason ?? "");
            statusMessage = "Encrypted client review package created.";
        });
    }

    private async Task SelectImportFileAsync(InputFileChangeEventArgs args)
    {
        statusMessage = null;
        preview = null;
        confirmApply = false;
        var file = args.File;
        importFileName = file.Name;
        if (file.Size > 25 * 1024 * 1024)
        {
            importBytes = null;
            ShowError("The package exceeds the 25 MB safety limit.");
            return;
        }
        await using var stream = file.OpenReadStream(25 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        importBytes = memory.ToArray();
    }

    private async Task PreviewAsync()
    {
        await RunAsync(async _ =>
        {
            preview = await TransferService.PreviewAsync(importBytes!, importPassphrase ?? "");
            confirmApply = false;
            statusMessage = preview.CanApply
                ? "Preview complete. Review the live match before applying."
                : "Preview complete with conflicts.";
            isError = !preview.CanApply;
        });
    }

    private async Task ApplyAsync()
    {
        await RunAsync(async user =>
        {
            var result = await TransferService.ApplyAsync(
                importBytes!, importPassphrase ?? "", user, importReason ?? "");
            statusMessage =
                $"Package applied to {result.ClientDisplayName}. Assessment #{result.AssessmentId} " +
                $"and {result.EvidenceImported} evidence item(s) imported.";
            preview = null;
            confirmApply = false;
        });
    }

    private async Task RunAsync(Func<string?, Task> action)
    {
        isBusy = true;
        isError = false;
        statusMessage = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await action(auth.User.Identity?.Name);
        }
        catch (ValidationException ex)
        {
            ShowError(ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            ShowError(ex.Message);
        }
        catch (KeyNotFoundException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowError(string message)
    {
        isError = true;
        statusMessage = message;
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not captured" : value;
}
