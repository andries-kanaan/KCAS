@page "/compliance/review-transfers"
@rendermode InteractiveServer
@attribute [Authorize(Policy = KcasPermissions.ComplianceManage)]
@using System.ComponentModel.DataAnnotations
@using KCAS.Admin.Data
@inject ClientReviewTransferService TransferService
@inject ClientReviewFamilyTransferService FamilyTransferService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Client review transfers</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Controlled operational transfer</p>
        <h1>Client review transfers</h1>
        <p class="lede">Move an approved local client review to live KCAS without database replacement or manual recapture.</p>
    </div>
</div>

<div class="alert alert-info">
    Packages are AES-256 encrypted and contain verified investment-reconciliation decisions, evidence metadata and hashes, not document contents.
    The passphrase is never stored. Current package storage: <code>@TransferService.StorageRoot</code>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")">@statusMessage</div>
}

<section class="detail-grid">
    <article class="detail-panel form-panel">
        <h2>1. Export completed review</h2>
        <p class="text-muted">Only a finalised or approved client assessment can be exported.</p>
        <div class="border rounded p-3 mb-3">
            <div class="section-heading-row">
                <div>
                    <h3>Batch export</h3>
                    <p class="text-muted mb-0">Find completed assessments by date and export them as family bundles or individual packages.</p>
                </div>
            </div>
            <div class="import-grid">
                <label>
                    Completed since
                    <input class="form-control" type="date" value="@BatchCompletedSinceValue"
                           @onchange="BatchCompletedSinceChangedAsync" disabled="@isBusy" />
                </label>
                <div class="form-actions align-self-end">
                    <button class="btn btn-outline-primary" type="button" @onclick="LoadBatchCandidatesAsync" disabled="@isBusy">
                        List clients to transfer
                    </button>
                </div>
            </div>
            @if (batchGroups.Count > 0)
            {
                <div class="form-actions my-2">
                    <button class="btn btn-link btn-sm px-0" type="button" @onclick="SelectAllBatchGroups" disabled="@isBusy">Select all</button>
                    <button class="btn btn-link btn-sm" type="button" @onclick="ClearBatchSelection" disabled="@isBusy">Clear</button>
                    <button class="btn btn-primary btn-sm" type="button" @onclick="ExportSelectedBatchAsync"
                            disabled="@(isBusy || selectedBatchGroupKeys.Count == 0)">
                        Export selected (@selectedBatchGroupKeys.Count)
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Transfer</th>
                                <th>Group</th>
                                <th>Completed</th>
                                <th>Included</th>
                                <th>Excluded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in batchGroups)
                            {
                                <tr>
                                    <td>
                                        <input class="form-check-input" type="checkbox"
                                               checked="@selectedBatchGroupKeys.Contains(group.GroupKey)"
                                               @onchange="args => ToggleBatchGroup(group.GroupKey, args)"
                                               disabled="@isBusy" />
                                    </td>
                                    <td>
                                        <strong>@group.Label</strong>
                                        <div class="small text-muted">
                                            @(group.CanExportFamilyBundle ? "Family bundle" : "Single-client package")
                                        </div>
                                    </td>
                                    <td>@FormatDateTime(group.LatestCompletedAtUtc)</td>
                                    <td>
                                        @foreach (var member in group.Members.Where(member => member.HasCompletedAssessment))
                                        {
                                            <div>
                                                @member.FullName
                                                <span class="badge text-bg-secondary">@Display(member.FinalRating)</span>
                                                <span class="small text-muted">@member.AssessmentStatus · @member.LifecycleStatus</span>
                                                @if (member.IsEligibleByDate)
                                                {
                                                    <span class="badge text-bg-success">since date</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (group.ExcludedMemberCount == 0)
                                        {
                                            <span class="text-muted">None</span>
                                        }
                                        else
                                        {
                                            @foreach (var member in group.Members.Where(member => !member.HasCompletedAssessment))
                                            {
                                                <div class="small text-muted">@member.FullName — incomplete</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (batchExportResults.Count > 0)
            {
                <div class="alert alert-success mt-2">
                    <strong>Batch packages created</strong>
                    @foreach (var result in batchExportResults)
                    {
                        <div>
                            @result.Label:
                            <a href="@($"/compliance/review-transfers/{result.PackageId}/download")">@result.FileName</a>
                            <span class="small text-muted">(@result.MemberCount client@(result.MemberCount == 1 ? "" : "s"))</span>
                        </div>
                    }
                </div>
            }
        </div>
        <label>
            Client
            <input class="form-control" type="text" name="kcas-review-client-combobox"
                   role="combobox" list="review-transfer-client-options"
                   autocomplete="off" data-1p-ignore="true" data-lpignore="true"
                   value="@clientSearch" @oninput="ClientSearchChangedAsync"
                   placeholder="Start typing a name, surname, Kanaan ID or legacy ID" />
            <datalist id="review-transfer-client-options">
                @foreach (var client in clients)
                {
                    <option value="@ClientOptionValue(client)"></option>
                }
            </datalist>
        </label>
        @if (!string.IsNullOrWhiteSpace(clientSearch))
        {
            <button class="btn btn-link btn-sm px-0" type="button" @onclick="ClearClientSearch">
                Clear client search
            </button>
        }
        @if (requestedClientSelected)
        {
            <div class="text-muted small">
                The completed client assessment was selected from the client risk page.
            </div>
        }
        @if (selectedFamily is { Members.Count: > 1 })
        {
            <div class="form-check my-2">
                <input class="form-check-input" type="checkbox" id="family-export" @bind="exportAsFamily" />
                <label class="form-check-label" for="family-export">
                    Export all reviewed clients linked to Kanaan ID @selectedFamily.KanaanId as one family bundle
                </label>
            </div>
            @if (exportAsFamily)
            {
                <div class="border rounded p-2 mb-2">
                    @foreach (var member in selectedFamily.Members)
                    {
                        <div>
                            <strong>@member.DisplayName</strong>
                            <span class="badge @(member.HasCompletedAssessment ? "text-bg-success" : "text-bg-warning")">
                                @(member.HasCompletedAssessment ? "Included" : "Excluded — assessment incomplete")
                            </span>
                        </div>
                    }
                </div>
            }
        }
        <label>Export reason <textarea class="form-control" @bind="exportReason"></textarea></label>
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphrase" />
        </label>
        <label>
            Confirm passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="exportPassphraseConfirm" />
        </label>
        <button class="btn btn-primary" type="button" @onclick="ExportAsync"
                disabled="@(isBusy || exportClientId == 0)">
            Create encrypted package
        </button>

        @if (exportResult is not null)
        {
            <div class="alert alert-success mt-3">
                <strong>@exportResult.FileName</strong>
                <div>@exportResult.SizeBytes.ToString("N0") bytes</div>
                <div class="small text-muted">@exportResult.StoragePath</div>
                <a class="btn btn-outline-primary btn-sm mt-2"
                   href="@($"/compliance/review-transfers/{exportResult.PackageId}/download")">
                    Download package
                </a>
            </div>
        }
        @if (familyExportResult is not null)
        {
            <div class="alert alert-success mt-3">
                <strong>@familyExportResult.FileName</strong>
                <div>@familyExportResult.MemberCount client packages; @familyExportResult.ExcludedMemberCount excluded</div>
                <div>@familyExportResult.SizeBytes.ToString("N0") bytes</div>
                <div class="small text-muted">@familyExportResult.StoragePath</div>
                <a class="btn btn-outline-primary btn-sm mt-2"
                   href="@($"/compliance/review-transfers/{familyExportResult.PackageId}/download")">
                    Download family bundle
                </a>
            </div>
        }
    </article>

    <article class="detail-panel form-panel">
        <h2>2. Preview and apply on live</h2>
        <p class="text-muted">Preview never changes data. Apply is blocked if client, methodology or assessment data conflicts.</p>
        <label>
            Encrypted package
            <InputFile class="form-control" OnChange="SelectImportFileAsync" accept=".kcas-review,.kcas-family-review" />
        </label>
        @if (!string.IsNullOrWhiteSpace(importFileName))
        {
            <div class="text-muted small">Selected: @importFileName</div>
        }
        <label>
            Package passphrase
            <input class="form-control" type="password" autocomplete="new-password" @bind="importPassphrase" />
        </label>
        <button class="btn btn-outline-primary" type="button" @onclick="PreviewAsync"
                disabled="@(isBusy || importBytes is null)">
            Preview package
        </button>

        @if (preview is not null)
        {
            <div class="mt-3">
                <h3>Preview</h3>
                <dl class="detail-list">
                    <dt>Client</dt><dd>@preview.Package.Client.DisplayName (@Display(preview.Package.Client.KanaanId))</dd>
                    <dt>Live match</dt><dd>@Display(preview.TargetClientName)</dd>
                    <dt>Live client folder</dt><dd>@Display(preview.TargetClientFolder)</dd>
                    <dt>Assessment</dt><dd>@preview.Package.Assessment.FinalRating — @preview.Package.Assessment.Status</dd>
                    <dt>Methodology</dt><dd>@preview.Package.Assessment.MethodologyName @preview.Package.Assessment.MethodologyVersionLabel</dd>
                    <dt>Evidence</dt><dd>@preview.NewEvidenceCount new; @preview.ExistingEvidenceCount already present</dd>
                    <dt>Entity ownership</dt><dd>@preview.Package.RelatedParties.Count related party record(s)</dd>
                    <dt>Investment verification</dt><dd>@preview.Package.InvestmentReconciliations.Count approved account decision(s)</dd>
                    <dt>Package</dt><dd><code>@preview.Package.PackageId</code></dd>
                </dl>
                @foreach (var warning in preview.Warnings)
                {
                    <div class="alert alert-warning">@warning</div>
                }
                @foreach (var conflict in preview.Conflicts)
                {
                    <div class="alert alert-danger">@conflict</div>
                }

                @if (preview.CanApply)
                {
                    <label>
                        Live import approval reason
                        <textarea class="form-control" @bind="importReason"></textarea>
                    </label>
                    <div class="form-check my-2">
                        <input class="form-check-input" type="checkbox" id="confirm-transfer" @bind="confirmApply" />
                        <label class="form-check-label" for="confirm-transfer">
                            I confirm this preview belongs to the correct live client.
                        </label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="ApplyAsync"
                            disabled="@(isBusy || !confirmApply)">
                        Apply reviewed package
                    </button>
                }
            </div>
        }
        @if (familyPreview is not null)
        {
            <div class="mt-3">
                <h3>Family preview — Kanaan ID @familyPreview.Bundle.KanaanId</h3>
                <p>
                    @familyPreview.Bundle.Members.Count packaged client(s)
                    @if (familyPreview.Bundle.ExcludedMembers.Count > 0)
                    {
                        <span>; @familyPreview.Bundle.ExcludedMembers.Count linked client(s) excluded at export</span>
                    }
                </p>
                @foreach (var conflict in familyPreview.Conflicts)
                {
                    <div class="alert alert-danger">@conflict</div>
                }
                @foreach (var excluded in familyPreview.Bundle.ExcludedMembers)
                {
                    <div class="alert alert-warning">
                        <strong>@excluded.DisplayName</strong> was not packaged: @excluded.Reason
                    </div>
                }
                @foreach (var member in familyPreview.Members)
                {
                    var memberPreview = member.ClientPreview;
                    <div class="border rounded p-3 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="@($"family-member-{member.Manifest.PackageId}")"
                                   checked="@selectedFamilyPackageIds.Contains(member.Manifest.PackageId)"
                                   disabled="@(!member.CanApply)"
                                   @onchange="args => ToggleFamilyMember(member.Manifest.PackageId, args)" />
                            <label class="form-check-label" for="@($"family-member-{member.Manifest.PackageId}")">
                                <strong>@member.Manifest.DisplayName</strong>
                                @if (memberPreview is not null)
                                {
                                    <span> — live match: @Display(memberPreview.TargetClientName)</span>
                                }
                            </label>
                        </div>
                        @if (memberPreview is not null)
                        {
                            <div class="small text-muted">
                                @memberPreview.Package.Assessment.FinalRating assessment;
                                @memberPreview.NewEvidenceCount new evidence item(s);
                                @memberPreview.Package.InvestmentReconciliations.Count investment decision(s);
                                folder: @Display(memberPreview.TargetClientFolder)
                            </div>
                            @foreach (var warning in memberPreview.Warnings)
                            {
                                <div class="alert alert-warning py-1 mt-1 mb-0">@warning</div>
                            }
                        }
                        @foreach (var conflict in member.AllConflicts)
                        {
                            <div class="alert alert-danger py-1 mt-1 mb-0">@conflict</div>
                        }
                        @if (memberPreview?.AlreadyApplied == true)
                        {
                            <div class="alert alert-info py-1 mt-1 mb-0">Already applied; it will not be imported again.</div>
                        }
                    </div>
                }
                @if (familyPreview.CanApply)
                {
                    <label>
                        Live import approval reason
                        <textarea class="form-control" @bind="importReason"></textarea>
                    </label>
                    <div class="form-check my-2">
                        <input class="form-check-input" type="checkbox" id="confirm-family-transfer" @bind="confirmApply" />
                        <label class="form-check-label" for="confirm-family-transfer">
                            I confirm the selected family members match the correct live clients.
                        </label>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="ApplyAsync"
                            disabled="@(isBusy || !confirmApply || selectedFamilyPackageIds.Count == 0)">
                        Apply selected family packages
                    </button>
                }
            </div>
        }
    </article>
</section>

@code {
    [SupplyParameterFromQuery(Name = "clientId")]
    private int? requestedClientId { get; set; }

    private List<ClientReviewTransferClientOption> clients = [];
    private int exportClientId;
    private string? clientSearch;
    private bool requestedClientSelected;
    private bool exportAsFamily;
    private ClientReviewFamilyGroup? selectedFamily;
    private string? exportReason = "Transfer completed client review from local KCAS to live KCAS.";
    private string? exportPassphrase;
    private string? exportPassphraseConfirm;
    private ClientReviewExportResult? exportResult;
    private ClientReviewFamilyExportResult? familyExportResult;
    private DateOnly batchCompletedSince = DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
    private List<ClientReviewBatchTransferGroup> batchGroups = [];
    private HashSet<string> selectedBatchGroupKeys = new(StringComparer.OrdinalIgnoreCase);
    private List<BatchExportResultView> batchExportResults = [];
    private byte[]? importBytes;
    private string? importFileName;
    private string? importPassphrase;
    private string? importReason = "Approve import of completed client review into live KCAS.";
    private ClientReviewTransferPreview? preview;
    private ClientReviewFamilyPreview? familyPreview;
    private HashSet<string> selectedFamilyPackageIds = new(StringComparer.OrdinalIgnoreCase);
    private bool confirmApply;
    private bool isBusy;
    private bool isError;
    private string? statusMessage;
    private string BatchCompletedSinceValue => batchCompletedSince.ToString("yyyy-MM-dd");

    protected override async Task OnParametersSetAsync()
    {
        clients = await TransferService.LoadClientOptionsAsync();
        requestedClientSelected = requestedClientId.HasValue &&
                                  clients.Any(client => client.Id == requestedClientId.Value);
        if (requestedClientSelected)
        {
            exportClientId = requestedClientId!.Value;
            clientSearch = ClientOptionValue(clients.Single(client => client.Id == exportClientId));
            await LoadSelectedFamilyAsync();
        }
    }

    private async Task LoadSelectedFamilyAsync()
    {
        exportAsFamily = false;
        selectedFamily = exportClientId > 0
            ? await FamilyTransferService.LoadFamilyAsync(exportClientId)
            : null;
    }

    private async Task BatchCompletedSinceChangedAsync(ChangeEventArgs args)
    {
        if (DateOnly.TryParse(args.Value?.ToString(), out var parsed))
        {
            batchCompletedSince = parsed;
        }
        await LoadBatchCandidatesAsync();
    }

    private async Task LoadBatchCandidatesAsync()
    {
        await RunAsync(async _ =>
        {
            batchExportResults = [];
            batchGroups = await TransferService.LoadBatchCandidatesAsync(batchCompletedSince);
            selectedBatchGroupKeys = batchGroups.Select(group => group.GroupKey)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            statusMessage = batchGroups.Count == 0
                ? "No finalised or approved client assessments were completed on or after the selected date."
                : $"Found {batchGroups.Count} transfer group(s) completed on or after {batchCompletedSince:yyyy-MM-dd}.";
        });
    }

    private void SelectAllBatchGroups()
    {
        selectedBatchGroupKeys = batchGroups.Select(group => group.GroupKey)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void ClearBatchSelection()
    {
        selectedBatchGroupKeys.Clear();
    }

    private void ToggleBatchGroup(string groupKey, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedBatchGroupKeys.Add(groupKey);
        }
        else
        {
            selectedBatchGroupKeys.Remove(groupKey);
        }
    }

    private async Task ExportSelectedBatchAsync()
    {
        if (exportPassphrase != exportPassphraseConfirm)
        {
            ShowError("The export passphrases do not match.");
            return;
        }

        await RunAsync(async user =>
        {
            exportResult = null;
            familyExportResult = null;
            batchExportResults = [];
            foreach (var group in batchGroups.Where(group => selectedBatchGroupKeys.Contains(group.GroupKey)))
            {
                if (group.CanExportFamilyBundle)
                {
                    var exported = await FamilyTransferService.ExportAsync(
                        group.AnchorClientId, exportPassphrase ?? "", user, exportReason ?? "");
                    batchExportResults.Add(new BatchExportResultView(
                        group.Label,
                        exported.PackageId,
                        exported.FileName,
                        exported.StoragePath,
                        exported.MemberCount));
                    continue;
                }

                foreach (var member in group.Members.Where(member => member.IsEligibleByDate))
                {
                    var exported = await TransferService.ExportAsync(
                        member.ClientId, exportPassphrase ?? "", user, exportReason ?? "");
                    batchExportResults.Add(new BatchExportResultView(
                        member.FullName,
                        exported.PackageId,
                        exported.FileName,
                        exported.StoragePath,
                        1));
                }
            }
            statusMessage = $"Created {batchExportResults.Count} encrypted transfer package(s).";
        });
    }

    private async Task ClientSearchChangedAsync(ChangeEventArgs args)
    {
        clientSearch = args.Value?.ToString();
        var selected = clients.FirstOrDefault(client =>
            string.Equals(ClientOptionValue(client), clientSearch, StringComparison.OrdinalIgnoreCase));
        var selectedId = selected?.Id ?? 0;
        if (selectedId != exportClientId)
        {
            exportClientId = selectedId;
            await LoadSelectedFamilyAsync();
        }
    }

    private async Task ClearClientSearch()
    {
        clientSearch = null;
        exportClientId = 0;
        await LoadSelectedFamilyAsync();
    }

    private static string ClientOptionValue(ClientReviewTransferClientOption client) =>
        $"{FullClientName(client)} — Kanaan {Display(client.KanaanId)} — Legacy {Display(client.LegacyClientId?.ToString())}";

    private static string FullClientName(ClientReviewTransferClientOption client)
    {
        var displayName = client.DisplayName.Trim();
        var surname = client.SurnameOrEntityName?.Trim();
        if (string.IsNullOrWhiteSpace(surname) ||
            string.Equals(displayName, surname, StringComparison.OrdinalIgnoreCase))
        {
            return displayName;
        }
        return $"{displayName} {surname}";
    }

    private async Task ExportAsync()
    {
        if (exportPassphrase != exportPassphraseConfirm)
        {
            ShowError("The export passphrases do not match.");
            return;
        }
        await RunAsync(async user =>
        {
            exportResult = null;
            familyExportResult = null;
            if (exportAsFamily)
            {
                familyExportResult = await FamilyTransferService.ExportAsync(
                    exportClientId, exportPassphrase ?? "", user, exportReason ?? "");
                statusMessage =
                    $"Encrypted family bundle created with {familyExportResult.MemberCount} client packages.";
            }
            else
            {
                exportResult = await TransferService.ExportAsync(
                    exportClientId, exportPassphrase ?? "", user, exportReason ?? "");
                statusMessage = "Encrypted client review package created.";
            }
        });
    }

    private async Task SelectImportFileAsync(InputFileChangeEventArgs args)
    {
        statusMessage = null;
        preview = null;
        familyPreview = null;
        selectedFamilyPackageIds.Clear();
        confirmApply = false;
        var file = args.File;
        importFileName = file.Name;
        if (file.Size > 100 * 1024 * 1024)
        {
            importBytes = null;
            ShowError("The package exceeds the 100 MB family-bundle safety limit.");
            return;
        }
        await using var stream = file.OpenReadStream(100 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        importBytes = memory.ToArray();
    }

    private async Task PreviewAsync()
    {
        await RunAsync(async _ =>
        {
            preview = null;
            familyPreview = null;
            selectedFamilyPackageIds.Clear();
            if (ClientReviewFamilyTransferService.IsFamilyBundle(importBytes!))
            {
                familyPreview = await FamilyTransferService.PreviewAsync(
                    importBytes!, importPassphrase ?? "");
                foreach (var member in familyPreview.Members.Where(member => member.CanApply))
                {
                    selectedFamilyPackageIds.Add(member.Manifest.PackageId);
                }
            }
            else
            {
                preview = await TransferService.PreviewAsync(importBytes!, importPassphrase ?? "");
            }
            confirmApply = false;
            var canApply = familyPreview?.CanApply ?? preview?.CanApply ?? false;
            statusMessage = canApply
                ? "Preview complete. Review the live match before applying."
                : "Preview complete with conflicts.";
            isError = !canApply;
        });
    }

    private async Task ApplyAsync()
    {
        await RunAsync(async user =>
        {
            if (familyPreview is not null)
            {
                var result = await FamilyTransferService.ApplyAsync(
                    importBytes!, importPassphrase ?? "", user, importReason ?? "",
                    selectedFamilyPackageIds);
                var applied = result.Members.Count(member => member.Status == "Applied");
                var notApplied = result.Members.Count - applied;
                var verificationMessages = result.Members
                    .Where(member => member.Status == "Applied" && !string.IsNullOrWhiteSpace(member.Message))
                    .Select(member => $"{member.DisplayName}: {member.Message}")
                    .ToList();
                statusMessage = $"Family bundle applied: {applied} client(s) imported" +
                    (notApplied > 0 ? $"; {notApplied} not applied." : ".") +
                    (verificationMessages.Count == 0 ? "" : $" {string.Join(" ", verificationMessages)}");
            }
            else
            {
                var result = await TransferService.ApplyAsync(
                    importBytes!, importPassphrase ?? "", user, importReason ?? "");
                statusMessage =
                    $"Package applied to {result.ClientDisplayName}. Assessment #{result.AssessmentId} " +
                    $"and {result.EvidenceImported} evidence item(s) imported." +
                    (result.EvidenceVerificationScanRunId.HasValue
                        ? $" Live evidence folder verified by scan {result.EvidenceVerificationScanRunId.Value}."
                        : "") +
                    (string.IsNullOrWhiteSpace(result.EvidenceVerificationWarning)
                        ? ""
                        : $" {result.EvidenceVerificationWarning}");
            }
            preview = null;
            familyPreview = null;
            selectedFamilyPackageIds.Clear();
            confirmApply = false;
        });
    }

    private void ToggleFamilyMember(string packageId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            selectedFamilyPackageIds.Add(packageId);
        }
        else
        {
            selectedFamilyPackageIds.Remove(packageId);
        }
    }

    private async Task RunAsync(Func<string?, Task> action)
    {
        isBusy = true;
        isError = false;
        statusMessage = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            await action(auth.User.Identity?.Name);
        }
        catch (ValidationException ex)
        {
            ShowError(ex.Message);
        }
        catch (InvalidOperationException ex)
        {
            ShowError(ex.Message);
        }
        catch (KeyNotFoundException ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowError(string message)
    {
        isError = true;
        statusMessage = message;
    }

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not captured" : value;

    private static string FormatDateTime(DateTime value) =>
        value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private sealed record BatchExportResultView(
        string Label,
        string PackageId,
        string FileName,
        string StoragePath,
        int MemberCount);
}
