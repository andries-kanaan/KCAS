@inherits LayoutComponentBase

<a class="skip-navigation" href="#main-content">Skip to content</a>

<div class="app-shell">
    <input id="sidebar-toggle" class="sidebar-toggle" type="checkbox" />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main id="main-content" class="main-panel" tabindex="-1">
        <div class="top-row">
            <label class="sidebar-toggle-button" for="sidebar-toggle" title="Toggle sidebar" aria-label="Toggle sidebar">
                <span></span>
                <span></span>
                <span></span>
            </label>
            <div class="top-brand">
                <img src="images/kanaan-header.jpg" alt="Kanaan Asset Managers" />
            </div>
            <div class="top-title">
                <p class="top-kicker">Kanaan Client Administration System</p>
                <span class="workspace-title">KCAS workspace</span>
            </div>
            <AuthorizeView><Authorized><a class="account-link" href="/Account/Manage">Account</a></Authorized><NotAuthorized><a class="account-link" href="/Account/Login">Sign in</a></NotAuthorized></AuthorizeView>
        </div>

        <article class="content-shell">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
