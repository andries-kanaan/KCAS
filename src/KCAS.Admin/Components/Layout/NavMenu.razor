@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider Authentication
@inject IAuthorizationService Authorization

<div class="brand-row">
    <div class="brand-mark" aria-hidden="true">K</div>
    <div><a class="navbar-brand" href="/">KCAS</a><p>Kanaan Asset Managers</p></div>
</div>
<input id="workspace-menu-toggle" type="checkbox" aria-label="Open navigation" class="navbar-toggler" />
<div class="nav-scrollable workspace-navigation" onclick="if(event.target.closest('a')) document.getElementById('workspace-menu-toggle').checked = false; if(event.target.closest('summary') &amp;&amp; document.getElementById('sidebar-toggle').checked) { event.preventDefault(); document.getElementById('sidebar-toggle').checked = false; event.target.closest('details').open = true; }">
    <nav aria-label="Main navigation">
        <div class="nav-item px-3"><a class="nav-link @(activeHref == "/" ? "active" : null)" href="/" title="Home" aria-current="@(activeHref == "/" ? "page" : null)"><span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span><span>Home</span></a></div>
        @foreach (var group in groups)
        {
            var isCurrentGroup = group.Items.Any(item => item.Href == activeHref);
            @if (group.Items.Count == 1)
            {
                var item = group.Items[0];
                <div class="nav-item px-3"><a class="nav-link @(isCurrentGroup ? "active" : null)" href="@item.Href" aria-current="@(isCurrentGroup ? "page" : null)" title="@item.Label"><span class="bi @group.Icon" aria-hidden="true"></span><span>@(group.Label == "Advice" ? "Advice" : item.Label)</span></a></div>
            }
            else
            {
            <details class="nav-group @(isCurrentGroup ? "current-group" : null)" name="workspace-menu" open="@isCurrentGroup" @key="group.Label">
                <summary title="@group.Label"><span class="bi @group.Icon" aria-hidden="true"></span><span class="nav-group-label">@group.Label</span><span class="nav-group-chevron" aria-hidden="true">&#8250;</span></summary>
                <div class="nav-group-items">
                    @foreach (var item in group.Items)
                    {
                        <div class="nav-item"><a class="nav-link @(activeHref == item.Href ? "active" : null)" href="@item.Href" aria-current="@(activeHref == item.Href ? "page" : null)">@item.Label</a></div>
                    }
                </div>
            </details>
            }
        }
    </nav>
    <div class="navigation-account">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3"><a class="nav-link" href="/Account/Manage" title="@context.User.Identity?.Name"><span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span><span class="account-name">@context.User.Identity?.Name</span></a></div>
                <div class="nav-item px-3"><form action="/Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="@currentUrl" /><button type="submit" class="nav-link"><span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span>Sign out</button></form></div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3"><a class="nav-link" href="/Account/Login">Sign in</a></div>
                <div class="nav-item px-3"><a class="nav-link" href="/Account/Register">Register</a></div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private string currentUrl = "";
    private string? activeHref;
    private IReadOnlyList<WorkspaceNavigationGroup> groups = [];

    protected override async Task OnInitializedAsync()
    {
        SetLocation(NavigationManager.Uri);
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var allowed = new HashSet<string>();
        foreach (var policy in WorkspaceNavigation.Groups.SelectMany(group => group.Items).Select(item => item.Policy).Distinct())
            if ((await Authorization.AuthorizeAsync(user, null, policy)).Succeeded) allowed.Add(policy);
        groups = WorkspaceNavigation.VisibleGroups(allowed);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void SetLocation(string location)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(location);
        activeHref = WorkspaceNavigation.ActiveHref(currentUrl);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() => { SetLocation(e.Location); StateHasChanged(); });
    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}

