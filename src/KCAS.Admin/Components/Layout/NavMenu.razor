@implements IDisposable

@inject NavigationManager NavigationManager

<div class="brand-row">
    <div class="brand-mark" aria-hidden="true">K</div>
    <div>
        <a class="navbar-brand" href="">KCAS</a>
        <p>Navigation</p>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-section">Workspace</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clients">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Clients
            </NavLink>
        </div>

        <AuthorizeView Policy="@KcasPermissions.InvestmentsView">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="investments/summary">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Investment Summary (IS)
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@KcasPermissions.InvestmentsManage">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="investments/reconciliation">
                        <span class="bi bi-arrow-repeat" aria-hidden="true"></span> Investment reconciliation
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@KcasPermissions.SecurityManage">
            <Authorized>
                <div class="nav-section">Administration</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="security">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Security
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@KcasPermissions.LegacyImportsView">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="imports">
                        <span class="bi bi-arrow-repeat" aria-hidden="true"></span> Legacy imports
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@KcasPermissions.ComplianceView">
            <Authorized>
                <details class="nav-group" open="@ComplianceMenuOpen">
                    <summary @onclick="OpenComplianceOverview">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                        <span>Compliance</span>
                        <span class="nav-group-chevron" aria-hidden="true">›</span>
                    </summary>
                    <div class="nav-group-items">
                        <AuthorizeView Policy="@KcasPermissions.ClientsView">
                            <Authorized Context="clientReviewContext">
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="clients/operational-review">Client reviews</NavLink>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="compliance/goaml">Daily compliance</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="compliance/programme">Programme and controls</NavLink>
                        </div>
                        <AuthorizeView Policy="@KcasPermissions.InspectionsView">
                            <Authorized Context="inspectionContext">
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="compliance/inspections">Inspection readiness</NavLink>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </details>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private bool ComplianceMenuOpen => currentUrl?.StartsWith("compliance", StringComparison.OrdinalIgnoreCase) == true;

    private void OpenComplianceOverview() => NavigationManager.NavigateTo("compliance");

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

